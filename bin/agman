#!/usr/bin/env bash
#
# agman — agent manager: switchable config profiles for AI coding agents,
# in the spirit of AWS_PROFILE.
#
# A profile is a directory under $AGMAN_HOME holding one config tree per tool:
#
#   ~/.agman/work/claude/       -> ~/.claude
#   ~/.agman/work/claude.json   -> ~/.claude.json
#   ~/.agman/work/codex/        -> ~/.codex
#   ~/.agman/work/gemini/       -> ~/.gemini
#
# `agman use` activates a profile by symlinking each tool's config path at it.
# Symlinks are the only mechanism every tool supports: Codex has CODEX_HOME and
# Claude Code has CLAUDE_CONFIG_DIR, but Gemini CLI has no config-dir override
# at all. The original config is preserved as the 'global' profile on the first
# switch, and `agman off` restores it. The symlink is also the state marker: a
# real directory is unmanaged, a symlink into $AGMAN_HOME is an agman profile.
#
# Requires bash >= 3.2 (stock macOS bash works). No other dependencies.

set -euo pipefail

AGMAN_VERSION="0.20.0"

AGMAN_HOME="${AGMAN_HOME:-$HOME/.agman}"
# Where tool config paths live. Overridable so tests never touch a real home.
TARGET_HOME="${AGMAN_TARGET_HOME:-$HOME}"
DEFAULT_FILE="$AGMAN_HOME/.default"
GLOBAL_BACKUP="$AGMAN_HOME/global"
BACKUP_DIR="$AGMAN_HOME/.backups"
LAYOUT_FILE=".agman-layout"
LAYOUT_VERSION="2"
# Canonical shared Claude credential file. On Linux/Windows Claude Code keeps
# .credentials.json inside its config dir, so profiles that share an account
# symlink to this one file and token refreshes stay visible to all of them.
# On macOS credentials live in the Keychain and this stays absent.
SHARED_CREDS="$AGMAN_HOME/.credentials.json"
CREDS_BASENAME=".credentials.json"
# Per-profile account: a long-lived token plus the helper script Claude Code
# calls to read it. Never synced, never printed.
TOKEN_BASENAME=".agman-token"
HELPER_BASENAME="agman-apikey.sh"
# Machine-local state the tools keep inside their config dirs lives here and
# is shared by every profile (see ADAPTER_STATE). Set AGMAN_SHARE_STATE=0 to
# keep it per-profile instead.
SHARED_STATE="$AGMAN_HOME/.state"
# Claude Code resolves ~/.claude.json relative to the config dir when
# CLAUDE_CONFIG_DIR is set, but relative to $HOME otherwise. agman stores
# identity as a sibling of the claude tree so symlink mode can point
# ~/.claude.json at it; this link makes the same file reachable the other way,
# so `agman run/exec/env` sees the profile's account and user-scope MCP servers
# instead of a blank config Claude Code would otherwise create itself.
IDENTITY_LINK=".claude.json"
# Project-local profile selection. A repository can name the profile it wants;
# since the file arrives with a clone it is untrusted until confirmed once.
PROJECT_FILE=".agman"
TRUST_FILE="$AGMAN_HOME/.trusted"
AGMAN_RAW_URL="${AGMAN_RAW_URL:-https://raw.githubusercontent.com/memandip/agman/main}"
# Cloud sync credentials (`agman cloud`): url= and key= lines, mode 600.
# Machine-level, never part of any profile, never printed.
CLOUD_FILE="$AGMAN_HOME/.cloud"
# The public agman cloud server; `cloud login` offers it when no URL is given.
CLOUD_DEFAULT_URL="https://agman.vercel.app"

# --- adapter registry -------------------------------------------------------
#
# Parallel indexed arrays keep this readable under bash 3.2, which has no
# associative arrays. Each link entry is `profile_path:home_path:type`, where
# type is d (directory) or f (file).
ADAPTER_NAMES=(claude codex gemini)
ADAPTER_LABELS=("Claude Code" "Codex CLI" "Gemini CLI")
ADAPTER_CMDS=(claude codex gemini)
ADAPTER_LINKS=(
  "claude:.claude:d claude.json:.claude.json:f"
  "codex:.codex:d"
  "gemini:.gemini:d"
)
# Env var that redirects a tool's config dir, or "-" when the tool has none.
# Used by `agman env`/`run`/`exec` for per-shell overrides.
ADAPTER_ENVVARS=(CLAUDE_CONFIG_DIR CODEX_HOME -)
# State that is your work, or another product's, rather than a profile's
# persona, yet lives inside the managed config dir. Claude Code keeps a
# resumable session at <config dir>/projects/<encoded-cwd>/<session-id>.jsonl,
# Codex keeps its rollouts under sessions/ and a plugin cache under .tmp/, and
# Antigravity parks a multi-GB browser profile inside ~/.gemini. Swapping the
# whole dir per profile would strand every session, hand each profile its own
# copy of that bulk, and let `agman remove` delete it. So every profile
# symlinks these entries at one shared location. One `name:type` list per
# adapter (d directory, f file). Claude's entries sit directly under
# $SHARED_STATE, the layout that predates multi-tool sharing; other tools nest
# under $SHARED_STATE/<tool>.
ADAPTER_STATE=(
  "projects:d history.jsonl:f todos:d shell-snapshots:d file-history:d session-env:d sessions:d"
  "sessions:d history.jsonl:f log:d tmp:d .tmp:d"
  "antigravity:d antigravity-browser-profile:d tmp:d history:d"
)

# Ephemeral or machine-local state that should not be cloned into a profile.
# Includes state other products drop into the managed trees (Antigravity keeps
# a full browser profile and recordings inside ~/.gemini).
SEED_EXCLUDES=(antigravity antigravity-browser-profile backups cache downloads
  file-history history ide locks log logs paste-cache projects session-env
  sessions shell-snapshots statsig tasks telemetry tmp .tmp todos
  history.jsonl mcp-needs-auth-cache.json .last-cleanup .DS_Store
  .credentials.json .agman-token agman-apikey.sh)

# ---------------------------------------------------------------------------
# helpers

die() { printf 'agman: %s\n' "$*" >&2; exit 1; }
warn() { printf 'agman: warning: %s\n' "$*" >&2; }

usage_die() { printf 'agman: %s\n' "$*" >&2; printf "Run 'agman help' for usage.\n" >&2; exit 2; }

profile_dir() { printf '%s/%s' "$AGMAN_HOME" "$1"; }

readlink_once() { readlink "$1" 2>/dev/null || true; }

adapter_count() { printf '%s' "${#ADAPTER_NAMES[@]}"; }

adapter_index() {
  local want="$1" i=0
  while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
    if [ "${ADAPTER_NAMES[$i]}" = "$want" ]; then printf '%s' "$i"; return 0; fi
    i=$((i + 1))
  done
  return 1
}

# Absolute path of a tool config path under the target home. AGMAN_CLAUDE_HOME
# stays honored for the Claude paths so older setups and the Homebrew formula
# test keep working.
target_path() {
  case "$1" in
    .claude)
      printf '%s' "${AGMAN_CLAUDE_HOME:-$TARGET_HOME/.claude}" ;;
    .claude.json)
      if [ -n "${AGMAN_CLAUDE_HOME:-}" ]; then
        printf '%s/.claude.json' "$(dirname "$AGMAN_CLAUDE_HOME")"
      else
        printf '%s/.claude.json' "$TARGET_HOME"
      fi ;;
    *) printf '%s/%s' "$TARGET_HOME" "$1" ;;
  esac
}

# Optional allowlist. AGMAN_TOOLS="claude codex" restricts agman to those tools
# and leaves every other config path alone.
adapter_enabled() {
  local name="$1" t
  [ -z "${AGMAN_TOOLS:-}" ] && return 0
  for t in ${AGMAN_TOOLS}; do
    [ "$t" = "$name" ] && return 0
  done
  return 1
}

# A tool is in scope for a profile when it is enabled and either the profile
# already carries config for it, the CLI is installed, or its config path
# exists on this machine.
adapter_in_scope() {
  local idx="$1" dir="$2" pair prof_rel home_rel
  adapter_enabled "${ADAPTER_NAMES[$idx]}" || return 1
  if [ -n "$dir" ]; then
    for pair in ${ADAPTER_LINKS[$idx]}; do
      prof_rel="${pair%%:*}"
      [ -e "$dir/$prof_rel" ] && return 0
    done
  fi
  command -v "${ADAPTER_CMDS[$idx]}" >/dev/null 2>&1 && return 0
  for pair in ${ADAPTER_LINKS[$idx]}; do
    home_rel="${pair#*:}"; home_rel="${home_rel%:*}"
    [ -e "$(target_path "$home_rel")" ] && return 0
  done
  return 1
}

validate_name() {
  local name="${1:-}"
  [ -n "$name" ] || usage_die "profile name required"
  [ "${#name}" -le 64 ] || die "profile name too long (max 64 chars)"
  case "$name" in
    .*|-*) die "invalid profile name '$name' (must not start with '.' or '-')" ;;
    *[!A-Za-z0-9._-]*) die "invalid profile name '$name' (allowed: letters, digits, '.', '_', '-')" ;;
  esac
}

require_creatable_name() {
  validate_name "$1"
  case "$1" in
    default|off|none|current|help|global)
      die "'$1' is a reserved word and cannot be used as a profile name" ;;
  esac
}

require_profile() {
  validate_name "$1"
  [ -d "$(profile_dir "$1")" ] || die "profile '$1' not found (run 'agman list')"
}

default_profile() {
  [ -f "$DEFAULT_FILE" ] || return 1
  local name
  IFS= read -r name < "$DEFAULT_FILE" || true
  [ -n "$name" ] || return 1
  printf '%s' "$name"
}

# Profile name owning a symlink target, for both layouts:
#   $AGMAN_HOME/work         (layout 1)
#   $AGMAN_HOME/work/claude  (layout 2)
profile_name_from_target() {
  local t="$1" rest
  case "$t" in
    "$AGMAN_HOME"/*)
      rest="${t#"$AGMAN_HOME"/}"
      rest="${rest%%/*}"
      [ -n "$rest" ] || return 1
      case "$rest" in .*) return 1 ;; esac
      printf '%s' "$rest" ;;
    *) return 1 ;;
  esac
}

# --- layout versioning -----------------------------------------------------

profile_layout() {
  local dir="$1" v=""
  if [ -f "$dir/$LAYOUT_FILE" ]; then
    IFS= read -r v < "$dir/$LAYOUT_FILE" || true
    case "$v" in 1|2) printf '%s' "$v"; return 0 ;; esac
  fi
  [ -d "$dir/claude" ] && { printf '2'; return 0; }
  # Layout 1 kept the Claude config tree at the profile root.
  if [ -f "$dir/.claude.json" ] || [ -f "$dir/CLAUDE.md" ] || [ -f "$dir/settings.json" ] \
     || [ -d "$dir/skills" ] || [ -d "$dir/agents" ] || [ -d "$dir/plugins" ]; then
    printf '1'; return 0
  fi
  printf '%s' "$LAYOUT_VERSION"
}

# Claude paths inside a profile, layout-aware, so read-only commands stay
# correct for profiles that have not been migrated yet.
profile_claude_dir() {
  local dir="$1"
  if [ "$(profile_layout "$dir")" = "1" ]; then printf '%s' "$dir"
  else printf '%s/claude' "$dir"; fi
}

profile_identity_file() {
  local dir="$1"
  if [ "$(profile_layout "$dir")" = "1" ]; then printf '%s/.claude.json' "$dir"
  else printf '%s/claude.json' "$dir"; fi
}

# Move a layout-1 profile into per-tool subdirectories, keeping a full copy of
# the pre-migration state under $AGMAN_HOME/.backups first.
migrate_profile() {
  local dir="$1" name entry base backup stamp
  name="${dir##*/}"
  [ "$(profile_layout "$dir")" = "1" ] || return 0

  stamp="$(date +%Y%m%d%H%M%S 2>/dev/null || printf 'backup')"
  backup="$BACKUP_DIR/${name}-layout1-$stamp"
  mkdir -p "$BACKUP_DIR"
  cp -R "$dir" "$backup" || die "could not back up profile '$name' before migrating"

  mkdir -p "$dir/claude"
  while IFS= read -r -d '' entry; do
    base="${entry##*/}"
    case "$base" in
      claude|claude.json|"$LAYOUT_FILE") continue ;;
      .claude.json) mv "$entry" "$dir/claude.json" ;;
      *) mv "$entry" "$dir/claude/$base" ;;
    esac
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -print0)

  printf '%s\n' "$LAYOUT_VERSION" > "$dir/$LAYOUT_FILE"
  printf "Migrated profile '%s' to the multi-tool layout (backup: %s).\n" "$name" "$backup"
  return 0
}

migrate_all_profiles() {
  [ -d "$AGMAN_HOME" ] || return 0
  local entry any=0
  for entry in "$AGMAN_HOME"/*/; do
    [ -d "$entry" ] || continue
    entry="${entry%/}"
    if [ "$(profile_layout "$entry")" = "1" ]; then
      migrate_profile "$entry"
      any=1
    fi
  done
  [ "$any" = "1" ] && printf "Profiles now hold one config tree per tool (claude/, codex/, gemini/).\n"
  return 0
}

# --- state inspection -------------------------------------------------------

# Kind of a single target path: real | agman | foreign | absent
target_kind() {
  local p="$1"
  if [ -L "$p" ]; then
    if profile_name_from_target "$(readlink_once "$p")" >/dev/null 2>&1; then
      printf 'agman'
    else
      printf 'foreign'
    fi
  elif [ -e "$p" ]; then
    printf 'real'
  else
    printf 'absent'
  fi
}

# The active profile, determined from whichever managed path is a symlink.
active_profile() {
  local i=0 pair home_rel t name
  while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
    for pair in ${ADAPTER_LINKS[$i]}; do
      home_rel="${pair#*:}"; home_rel="${home_rel%:*}"
      t="$(target_path "$home_rel")"
      if [ -L "$t" ]; then
        if name="$(profile_name_from_target "$(readlink_once "$t")")"; then
          printf '%s' "$name"; return 0
        fi
      fi
    done
    i=$((i + 1))
  done
  return 1
}

# Tool names a profile currently has activated, space separated.
active_tools() {
  local i=0 pair home_rel t out=""
  while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
    for pair in ${ADAPTER_LINKS[$i]}; do
      home_rel="${pair#*:}"; home_rel="${home_rel%:*}"
      t="$(target_path "$home_rel")"
      if [ -L "$t" ] && profile_name_from_target "$(readlink_once "$t")" >/dev/null 2>&1; then
        out="$out ${ADAPTER_NAMES[$i]}"
        break
      fi
    done
    i=$((i + 1))
  done
  printf '%s' "${out# }"
}

is_seed_excluded() {
  local base="$1" x
  # Shared-state merge leftovers are per-machine copies of state; cloning them
  # would duplicate junk into every new profile.
  case "$base" in *.agman-conflict|*.agman-orphaned) return 0 ;; esac
  for x in "${SEED_EXCLUDES[@]}"; do
    if [ "$base" = "$x" ]; then return 0; fi
  done
  return 1
}

# Copy a config tree into a profile, skipping ephemeral state. Optionally
# symlinks the plugins dir instead of copying it.
seed_from_dir() {
  local src="$1" dst="$2" link_plugins="$3" entry base
  [ -d "$src" ] || return 0
  mkdir -p "$dst"
  while IFS= read -r -d '' entry; do
    base="${entry##*/}"
    if is_seed_excluded "$base"; then continue; fi
    if [ "$base" = "plugins" ] && [ "$link_plugins" = "1" ]; then
      if ! ln -s "$entry" "$dst/plugins" 2>/dev/null; then
        warn "symlinks unavailable on this filesystem; copying plugins instead"
        cp -R "$entry" "$dst/plugins"
      fi
      continue
    fi
    cp -R "$entry" "$dst/$base"
  done < <(find "$src" -mindepth 1 -maxdepth 1 -print0)
}

write_starter_claude_md() {
  local dir="$1" name="$2"
  mkdir -p "$dir"
  cat > "$dir/CLAUDE.md" <<EOF
# CLAUDE.md — $name profile (managed by agman)

Instructions here apply to every Claude Code session while this profile
is active. Replace this starter content with your own rules, for example:

- Coding style preferences
- Workflow rules ("always run tests before committing")
- Project or client context specific to this profile
EOF
}

# --- identity / auth inheritance ------------------------------------------
#
# Claude Code decides whether to run first-launch onboarding from
# ~/.claude.json, not from the credential store: its own code gates on
# `if (!config.hasCompletedOnboarding)`, and it treats auth as cached when
# `oauthAccount !== undefined || hasCompletedOnboarding === true`. A profile
# with an empty {} therefore triggers login even when a valid token exists.
# Seeding these keys is what makes a new profile inherit the current account.
IDENTITY_KEYS="oauthAccount hasCompletedOnboarding userID machineID lastOnboardingVersion"

json_tool() {
  if command -v jq >/dev/null 2>&1; then printf 'jq'
  elif command -v python3 >/dev/null 2>&1; then printf 'python3'
  else printf 'none'; fi
}

seed_identity() {
  local src="$1" dst="$2" tmp
  [ -f "$src" ] || return 1
  tmp="$dst.agman-tmp.$$"
  case "$(json_tool)" in
    jq)
      if ! jq -n --arg keys "$IDENTITY_KEYS" \
            --slurpfile s "$src" \
            '($keys | split(" ")) as $k
             | ($s[0] // {}) as $src
             | reduce $k[] as $key ({}; if ($src | has($key)) then .[$key] = $src[$key] else . end)' \
            > "$tmp" 2>/dev/null; then
        rm -f "$tmp"; return 1
      fi
      if [ -s "$dst" ] && jq -e . "$dst" >/dev/null 2>&1; then
        if jq -s '.[0] * .[1]' "$dst" "$tmp" > "$tmp.2" 2>/dev/null; then
          mv "$tmp.2" "$tmp"
        else
          rm -f "$tmp.2"
        fi
      fi
      ;;
    python3)
      if ! SRC="$src" DST="$dst" KEYS="$IDENTITY_KEYS" python3 -c '
import json, os, sys
src, dst, keys = os.environ["SRC"], os.environ["DST"], os.environ["KEYS"].split()
try:
    s = json.load(open(src))
except Exception:
    sys.exit(1)
if not isinstance(s, dict):
    sys.exit(1)
try:
    d = json.load(open(dst))
    if not isinstance(d, dict):
        d = {}
except Exception:
    d = {}
for k in keys:
    if k in s:
        d[k] = s[k]
sys.stdout.write(json.dumps(d, indent=2) + "\n")
' > "$tmp" 2>/dev/null; then
        rm -f "$tmp"; return 1
      fi
      ;;
    none)
      warn "neither jq nor python3 found; copying the whole config state to preserve login"
      cp "$src" "$tmp" || { rm -f "$tmp"; return 1; }
      ;;
  esac
  mv "$tmp" "$dst" || { rm -f "$tmp"; return 1; }
  chmod 600 "$dst" 2>/dev/null || true
  return 0
}

identity_source() {
  local live; live="$(target_path .claude.json)"
  if [ -f "$live" ] && [ ! -L "$live" ]; then
    printf '%s' "$live"; return 0
  fi
  if [ -d "$GLOBAL_BACKUP" ]; then
    local gf; gf="$(profile_identity_file "$GLOBAL_BACKUP")"
    [ -f "$gf" ] && { printf '%s' "$gf"; return 0; }
  fi
  if [ -L "$live" ]; then
    local t; t="$(readlink_once "$live")"
    [ -f "$t" ] && { printf '%s' "$t"; return 0; }
  fi
  return 1
}

has_identity() {
  local f; f="$(profile_identity_file "$1")"
  [ -f "$f" ] || return 1
  grep -q '"hasCompletedOnboarding"[[:space:]]*:[[:space:]]*true' "$f" 2>/dev/null && return 0
  grep -q '"oauthAccount"[[:space:]]*:[[:space:]]*{' "$f" 2>/dev/null && return 0
  return 1
}

adopt_shared_credentials() {
  local src; src="$(profile_claude_dir "$1")/$CREDS_BASENAME"
  [ -f "$src" ] || return 0
  [ -L "$src" ] && return 0
  if [ ! -e "$SHARED_CREDS" ]; then
    mv "$src" "$SHARED_CREDS" || return 1
    chmod 600 "$SHARED_CREDS" 2>/dev/null || true
    ln -s "$SHARED_CREDS" "$src" 2>/dev/null || cp "$SHARED_CREDS" "$src"
  fi
  return 0
}

link_shared_credentials() {
  local dir="$1" target
  target="$(profile_claude_dir "$dir")/$CREDS_BASENAME"
  # Drop a link left dangling by a previous 'off', which would otherwise look
  # like a credential file to Claude Code.
  if [ -L "$target" ] && [ ! -e "$target" ]; then rm -f "$target"; fi
  [ -f "$SHARED_CREDS" ] || return 0
  [ -L "$target" ] && return 0
  [ -e "$target" ] && return 0
  ln -s "$SHARED_CREDS" "$target" 2>/dev/null || cp "$SHARED_CREDS" "$target"
  return 0
}

# --- per-profile accounts ---------------------------------------------------
#
# A profile can authenticate as a different Claude account than the rest. The
# mechanism is Claude Code's own apiKeyHelper setting, which the docs state
# "appl[ies] to the CLI and the surfaces that wrap it, including the VS Code
# extension, the Agent SDK, and GitHub Actions", and which is honored from
# user-scope settings — exactly what `agman use` symlinks into place.
#
# The credential is a long-lived token from `claude setup-token` (one year, and
# it does not rotate). Snapshotting Keychain entries or .credentials.json is
# deliberately avoided: refresh tokens rotate on every use, so a snapshot is
# stale by the time you switch back and restoring it logs you out.

profile_token_file() { printf '%s/%s' "$(profile_claude_dir "$1")" "$TOKEN_BASENAME"; }
profile_helper_file() { printf '%s/%s' "$(profile_claude_dir "$1")" "$HELPER_BASENAME"; }
profile_settings_file() { printf '%s/settings.json' "$(profile_claude_dir "$1")"; }

profile_has_own_account() { [ -s "$(profile_token_file "$1")" ]; }

# Set a string key in a JSON file, preserving everything else. Returns 2 when a
# non-empty file cannot be merged safely for lack of jq and python3.
json_set_string_key() {
  local file="$1" key="$2" value="$3" tmp
  tmp="$file.agman-tmp.$$"
  case "$(json_tool)" in
    jq)
      if [ -s "$file" ] && jq -e . "$file" >/dev/null 2>&1; then
        jq --arg k "$key" --arg v "$value" '.[$k] = $v' "$file" > "$tmp" 2>/dev/null \
          || { rm -f "$tmp"; return 1; }
      else
        jq -n --arg k "$key" --arg v "$value" '{($k): $v}' > "$tmp" 2>/dev/null \
          || { rm -f "$tmp"; return 1; }
      fi ;;
    python3)
      if ! FILE="$file" KEY="$key" VALUE="$value" python3 -c '
import json, os, sys
f, k, v = os.environ["FILE"], os.environ["KEY"], os.environ["VALUE"]
try:
    d = json.load(open(f))
    if not isinstance(d, dict):
        d = {}
except Exception:
    d = {}
d[k] = v
sys.stdout.write(json.dumps(d, indent=2) + "\n")
' > "$tmp" 2>/dev/null; then rm -f "$tmp"; return 1; fi ;;
    none)
      if [ -s "$file" ]; then rm -f "$tmp"; return 2; fi
      printf '{\n  "%s": "%s"\n}\n' "$key" "$value" > "$tmp" ;;
  esac
  mv "$tmp" "$file"
}

# Delete keys from a JSON file. Returns 2 when it cannot be done safely.
json_del_keys() {
  local file="$1"; shift
  local keys="$*" tmp
  [ -f "$file" ] || return 0
  tmp="$file.agman-tmp.$$"
  case "$(json_tool)" in
    jq)
      jq --arg keys "$keys" 'delpaths([($keys | split(" "))[] | [.]])' "$file" > "$tmp" 2>/dev/null \
        || { rm -f "$tmp"; return 1; } ;;
    python3)
      if ! FILE="$file" KEYS="$keys" python3 -c '
import json, os, sys
f, keys = os.environ["FILE"], os.environ["KEYS"].split()
try:
    d = json.load(open(f))
    if not isinstance(d, dict):
        d = {}
except Exception:
    d = {}
for k in keys:
    d.pop(k, None)
sys.stdout.write(json.dumps(d, indent=2) + "\n")
' > "$tmp" 2>/dev/null; then rm -f "$tmp"; return 1; fi ;;
    none) rm -f "$tmp"; return 2 ;;
  esac
  mv "$tmp" "$file"
}

write_api_key_helper() {
  local dir="$1" helper rc
  helper="$(profile_helper_file "$dir")"
  mkdir -p "$(profile_claude_dir "$dir")"
  cat > "$helper" <<EOF
#!/bin/sh
# Written by agman. Prints this profile's Claude Code auth token.
# Claude Code calls this via apiKeyHelper and sends the value as an
# Authorization/X-Api-Key header. Failing loudly beats printing nothing.
set -e
f="\$(dirname "\$0")/$TOKEN_BASENAME"
[ -s "\$f" ] || { echo "agman: no token for this profile" >&2; exit 1; }
cat "\$f"
EOF
  chmod 700 "$helper"
  rc=0
  json_set_string_key "$(profile_settings_file "$dir")" apiKeyHelper "$helper" || rc=$?
  return "$rc"
}

remove_api_key_helper() {
  local dir="$1" rc
  rm -f "$(profile_helper_file "$dir")" "$(profile_token_file "$dir")"
  rc=0
  json_del_keys "$(profile_settings_file "$dir")" apiKeyHelper || rc=$?
  return "$rc"
}

# Keep a profile's apiKeyHelper path correct if AGMAN_HOME moved or the profile
# was renamed. Called from `use`, so activation is self-healing.
# Remove any per-account credential material from a profile. Used after cloning
# so a copy never inherits another profile's account: the token itself, the
# helper script, and the apiKeyHelper setting, which would otherwise still point
# at the source profile's helper and authenticate as that account.
strip_account_material() {
  local dir="$1" cdir
  cdir="$(profile_claude_dir "$dir")"
  rm -f "$cdir/$TOKEN_BASENAME" "$cdir/$HELPER_BASENAME"
  if [ -f "$cdir/settings.json" ] && grep -q '"apiKeyHelper"' "$cdir/settings.json" 2>/dev/null; then
    local rc=0
    json_del_keys "$cdir/settings.json" apiKeyHelper || rc=$?
    [ "$rc" = "0" ] || warn "could not remove apiKeyHelper from $cdir/settings.json; edit it by hand so this profile does not use another account's token"
  fi
  return 0
}

refresh_api_key_helper() {
  local dir="$1" settings helper
  profile_has_own_account "$dir" || return 0
  helper="$(profile_helper_file "$dir")"
  settings="$(profile_settings_file "$dir")"
  [ -f "$helper" ] || write_api_key_helper "$dir" >/dev/null 2>&1 || true
  if [ -f "$settings" ] && grep -q '"apiKeyHelper"' "$settings" 2>/dev/null; then
    grep -q "$helper" "$settings" 2>/dev/null && return 0
  fi
  write_api_key_helper "$dir" >/dev/null 2>&1 || \
    warn "profile has its own account but apiKeyHelper could not be written to $settings"
  return 0
}

# --- identity reachable from both access paths ------------------------------

# Path Claude Code reads identity from when CLAUDE_CONFIG_DIR points at a
# profile.
profile_identity_link() { printf '%s/%s' "$(profile_claude_dir "$1")" "$IDENTITY_LINK"; }

# True when a profile carries a real identity file inside its config dir. That
# is drift: Claude Code creates one there on any run that predates this link,
# leaving two files that disagree about the account.
profile_has_identity_drift() {
  local l; l="$(profile_identity_link "$1")"
  [ -e "$l" ] && [ ! -L "$l" ]
}

# Point the in-config-dir identity path at the profile's real identity file.
link_profile_identity() {
  local dir="$1" link real
  link="$(profile_identity_link "$dir")"
  real="$(profile_identity_file "$dir")"
  mkdir -p "$(profile_claude_dir "$dir")"
  [ -e "$real" ] || printf '{}\n' > "$real"

  if [ -L "$link" ]; then
    case "$(readlink_once "$link")" in
      "$real") return 0 ;;
      *) rm -f "$link" ;;
    esac
  elif [ -e "$link" ]; then
    # A real file Claude Code created before this link existed. Keep it rather
    # than deleting someone's state, but get it out of the way.
    rm -f "$link.agman-orphaned"
    mv "$link" "$link.agman-orphaned" 2>/dev/null || true
    warn "$(basename "$dir"): found an identity file Claude Code created inside the profile; kept it as $IDENTITY_LINK.agman-orphaned"
  fi
  ln -s "$real" "$link" 2>/dev/null || warn "could not link $IDENTITY_LINK into $(profile_claude_dir "$dir")"
  return 0
}

# --- shared session state --------------------------------------------------

share_state_enabled() { [ "${AGMAN_SHARE_STATE:-1}" != "0" ]; }

# Move every file from one tree into another, creating directories as needed.
# Merging has to happen file by file, not directory by directory: two profiles
# will both have projects/<encoded-cwd>/ for the same repo, and treating that
# shared parent as a collision would leave each profile seeing only its own
# half of the session history. Session files are UUID-named, so real conflicts
# are near-impossible; any that occur are left untouched rather than clobbered.
# Returns 0 when the source was fully absorbed, 1 when something was left.
merge_tree() {
  local src="$1" dst="$2" rel parent collided=0
  [ -d "$src" ] || return 0
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    if [ -L "$src/$rel" ] || [ ! -d "$src/$rel" ]; then
      if [ -e "$dst/$rel" ] || [ -L "$dst/$rel" ]; then
        collided=1
      else
        # Parameter expansion, not dirname: these paths are encoded working
        # directories like "-Users-me-work", which dirname reads as options.
        parent="${rel%/*}"
        [ "$parent" = "$rel" ] || mkdir -p "$dst/$parent" || collided=1
        mv "$src/$rel" "$dst/$rel" || collided=1
      fi
    else
      mkdir -p "$dst/$rel"
    fi
  done < <(cd "$src" 2>/dev/null && find . -mindepth 1 2>/dev/null | sed 's|^\./||' | sort)
  find "$src" -depth -type d -empty -delete 2>/dev/null || true
  [ -e "$src" ] || return 0
  [ "$collided" = "0" ] && rmdir "$src" 2>/dev/null && return 0
  return 1
}

# Where an adapter's shared state lives. Claude's predates multi-tool sharing
# and stays flat so links made by earlier releases keep resolving.
state_root() {
  if [ "${ADAPTER_NAMES[$1]}" = "claude" ]; then printf '%s' "$SHARED_STATE"
  else printf '%s/%s' "$SHARED_STATE" "${ADAPTER_NAMES[$1]}"; fi
}

# A tool's config tree inside a profile: its directory link, layout-aware for
# Claude.
profile_tool_dir() {
  local dir="$1" idx="$2" pair
  if [ "${ADAPTER_NAMES[$idx]}" = "claude" ]; then profile_claude_dir "$dir"; return 0; fi
  for pair in ${ADAPTER_LINKS[$idx]}; do
    case "$pair" in *:d) printf '%s/%s' "$dir" "${pair%%:*}"; return 0 ;; esac
  done
  return 1
}

# How many profiles currently point state paths at shared state. The env var
# alone is not the truth: disabling sharing later leaves existing links in
# place, and a diagnostic that reports the flag instead of the filesystem
# sends people looking in the wrong place.
count_shared_linked_profiles() {
  local n=0 entry i hit tdir pair target
  [ -d "$AGMAN_HOME" ] || { printf '0'; return 0; }
  for entry in "$AGMAN_HOME"/*/; do
    [ -d "$entry" ] || continue
    entry="${entry%/}"
    hit=0; i=0
    while [ "$hit" = "0" ] && [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
      tdir="$(profile_tool_dir "$entry" "$i")"
      for pair in ${ADAPTER_STATE[$i]}; do
        target="$tdir/${pair%%:*}"
        [ -L "$target" ] || continue
        case "$(readlink_once "$target")" in "$SHARED_STATE"/*) hit=1; break ;; esac
      done
      i=$((i + 1))
    done
    n=$((n + hit))
  done
  printf '%s' "$n"
}

# Copies a merge could not place. They are preserved rather than deleted, so
# they need to be discoverable or they sit unnoticed forever.
list_conflict_leftovers() {
  [ -d "$AGMAN_HOME" ] || return 0
  find "$AGMAN_HOME" -maxdepth 3 \
    \( -name '*.agman-conflict' -o -name '*.agman-orphaned' \) 2>/dev/null | sort
}

# Move a tool tree's real state entries into the shared directory. Merges
# directory contents when both sides exist rather than overwriting, and never
# deletes anything it could not place.
adopt_shared_state() {
  local idx="$1" tdir="$2" root pair name type src dst
  share_state_enabled || return 0
  [ -d "$tdir" ] || return 0
  root="$(state_root "$idx")"
  mkdir -p "$root"
  for pair in ${ADAPTER_STATE[$idx]}; do
    name="${pair%%:*}"; type="${pair##*:}"
    src="$tdir/$name"; dst="$root/$name"
    [ -L "$src" ] && continue
    [ -e "$src" ] || continue
    if [ ! -e "$dst" ]; then
      mv "$src" "$dst" || warn "could not move $name into shared state"
    elif [ "$type" = "d" ]; then
      if ! merge_tree "$src" "$dst"; then
        # Something could not be placed. Move it aside rather than leaving a
        # real directory here, which would shadow the shared one and hide half
        # the history from this profile.
        rm -rf "$src.agman-conflict"
        mv "$src" "$src.agman-conflict" 2>/dev/null || true
        warn "$name: entries with the same names already existed in shared state; moved this profile's copies to $name.agman-conflict"
      fi
    else
      mv "$src" "$src.agman-orphaned" 2>/dev/null || true
      warn "$name: shared state already had this file; kept this profile's copy as $name.agman-orphaned"
    fi
  done
  return 0
}

# Point a profile's state paths at the shared directory, for every enabled
# tool whose tree the profile carries (Claude's is always created).
link_shared_state() {
  local dir="$1" i=0 tdir root pair name type target
  share_state_enabled || return 0
  while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
    if adapter_enabled "${ADAPTER_NAMES[$i]}"; then
      tdir="$(profile_tool_dir "$dir" "$i")"
      [ "${ADAPTER_NAMES[$i]}" = "claude" ] && mkdir -p "$tdir"
      if [ -d "$tdir" ]; then
        root="$(state_root "$i")"
        mkdir -p "$root"
        adopt_shared_state "$i" "$tdir"
        for pair in ${ADAPTER_STATE[$i]}; do
          name="${pair%%:*}"; type="${pair##*:}"
          target="$tdir/$name"
          # Drop a link left dangling by a previous 'off'.
          if [ -L "$target" ] && [ ! -e "$target" ]; then rm -f "$target"; fi
          [ -L "$target" ] && continue
          [ -e "$target" ] && continue
          if [ "$type" = "d" ]; then
            mkdir -p "$root/$name"
          else
            [ -e "$root/$name" ] || : > "$root/$name"
          fi
          ln -s "$root/$name" "$target" 2>/dev/null || \
            warn "could not link $name into $tdir"
        done
      fi
    fi
    i=$((i + 1))
  done
  return 0
}

# Turn one tool's shared links back into real paths so a restored config works
# without agman, mirroring what 'off' does for credentials.
restore_shared_state() {
  local idx="$1" tdir="$2" root pair name target
  root="$(state_root "$idx")"
  [ -d "$root" ] || return 0
  for pair in ${ADAPTER_STATE[$idx]}; do
    name="${pair%%:*}"
    target="$tdir/$name"
    # Clear our own link so the real thing can take its place. A link somebody
    # else made is left alone.
    if [ -L "$target" ]; then
      case "$(readlink_once "$target")" in
        "$SHARED_STATE"/*) rm -f "$target" ;;
        *) continue ;;
      esac
    fi
    # The backup profile has no link at all: its state was moved into shared
    # state on the first switch, so hand it back whether or not a link existed.
    [ -e "$target" ] && continue
    [ -e "$root/$name" ] || continue
    mv "$root/$name" "$target" || warn "could not restore $name"
  done
  return 0
}

# Drop the empty placeholders link_shared_state created for a tool, never
# anything with content in it.
prune_empty_state() {
  local root pair name type
  root="$(state_root "$1")"
  [ -d "$root" ] || return 0
  for pair in ${ADAPTER_STATE[$1]}; do
    name="${pair%%:*}"; type="${pair##*:}"
    if [ "$type" = "d" ]; then
      rmdir "$root/$name" 2>/dev/null || true
    elif [ -f "$root/$name" ] && [ ! -s "$root/$name" ]; then
      rm -f "$root/$name"
    fi
  done
  rmdir "$root" 2>/dev/null || true
}

# Never prints token material.
profile_auth_state() {
  local dir="$1" f
  f="$(profile_claude_dir "$dir")/$CREDS_BASENAME"
  local ident="no-identity" creds="keychain-or-none"
  has_identity "$dir" && ident="identity-seeded"
  if profile_has_own_account "$dir"; then
    creds="own-account (token)"
  elif [ -L "$f" ]; then
    creds="shared-credentials"
  elif [ -f "$f" ]; then
    creds="own-credentials"
  fi
  printf '%s, %s' "$ident" "$creds"
}

# --- project-local profile selection ----------------------------------------

# Nearest .agman file at or above a directory, so it works from subdirectories
# the way .nvmrc and .tool-versions do.
find_project_file() {
  local dir="${1:-$PWD}"
  dir="$(cd "$dir" 2>/dev/null && pwd -P)" || return 1
  while :; do
    [ -f "$dir/$PROJECT_FILE" ] && { printf '%s/%s' "$dir" "$PROJECT_FILE"; return 0; }
    [ "$dir" = "/" ] && return 1
    dir="${dir%/*}"
    [ -n "$dir" ] || dir="/"
  done
}

# Read the profile name from a .agman file. Unknown keys are ignored so the
# format can grow without breaking older agman versions.
read_project_profile() {
  local file="$1" line key value
  [ -f "$file" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      \#*|"") continue ;;
    esac
    case "$line" in
      *:*)
        key="${line%%:*}"; value="${line#*:}" ;;
      *)
        # A bare profile name on its own line is accepted too.
        key="profile"; value="$line" ;;
    esac
    # Trim surrounding whitespace without invoking anything.
    key="${key#"${key%%[![:space:]]*}"}"; key="${key%"${key##*[![:space:]]}"}"
    value="${value#"${value%%[![:space:]]*}"}"; value="${value%"${value##*[![:space:]]}"}"
    if [ "$key" = "profile" ] && [ -n "$value" ]; then
      printf '%s' "$value"; return 0
    fi
  done < "$file"
  return 1
}

project_is_trusted() {
  local file="$1"
  [ -f "$TRUST_FILE" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    [ "$line" = "$file" ] && return 0
  done < "$TRUST_FILE"
  return 1
}

trust_project() {
  local file="$1"
  mkdir -p "$AGMAN_HOME"
  project_is_trusted "$file" && return 0
  printf '%s\n' "$file" >> "$TRUST_FILE"
}

# Resolve the profile a .agman file asks for, prompting once per file. A file
# that arrived with a clone is untrusted input, so it must never switch anything
# silently — the same reasoning behind Claude Code's approval dialog for
# external imports.
resolve_project_profile() {
  local quiet="${1:-}" file name reply
  file="$(find_project_file "$PWD")" || return 1
  name="$(read_project_profile "$file")" || {
    [ "$quiet" = "quiet" ] || warn "$file has no 'profile:' entry"
    return 1
  }
  validate_name "$name" 2>/dev/null || {
    [ "$quiet" = "quiet" ] || warn "$file names an invalid profile"
    return 1
  }
  if ! project_is_trusted "$file"; then
    if [ "$quiet" = "quiet" ]; then return 1; fi
    if [ ! -t 0 ]; then
      die "$file asks for profile '$name' but is not trusted yet. Run 'agman use' in an interactive terminal once to confirm."
    fi
    printf "%s asks agman to use profile '%s'.\n" "$file" "$name"
    printf "This file came from the project, not from you. Trust it? [y/N] "
    IFS= read -r reply || true
    case "$reply" in y|Y|yes|YES) trust_project "$file" ;; *) die "not trusted; nothing changed" ;; esac
  fi
  [ -d "$(profile_dir "$name")" ] || {
    [ "$quiet" = "quiet" ] && return 1
    die "$file asks for profile '$name', which does not exist. Create it with: agman create $name"
  }
  printf '%s' "$name"
}

# --- link engine ------------------------------------------------------------

# Make sure a profile-side path exists so the symlink never dangles.
ensure_profile_path() {
  local path="$1" type="$2"
  if [ "$type" = "d" ]; then
    [ -d "$path" ] || mkdir -p "$path"
  else
    [ -e "$path" ] || printf '{}\n' > "$path"
  fi
}

# Whether every path of a tool can be linked. Checked before anything is moved
# so a tool is never left half-activated: one refused path must not strand the
# others in the backup profile.
adapter_can_link() {
  local idx="$1" pair home_rel tgt tool="${ADAPTER_NAMES[$1]}"
  for pair in ${ADAPTER_LINKS[$idx]}; do
    home_rel="${pair#*:}"; home_rel="${home_rel%:*}"
    tgt="$(target_path "$home_rel")"
    # A real path is always linkable: the first switch backs the original
    # up, and when the backup already holds it link_one absorbs the stray
    # copy instead of wedging the tool (see link_one's real case).
    if [ "$(target_kind "$tgt")" = "foreign" ]; then
      warn "$tool: $tgt is a symlink not managed by agman; leaving this tool alone"
      return 1
    fi
  done
  return 0
}

# The profile a tool's links currently point at, from whichever of its
# managed paths is still an agman symlink. Empty when none survives.
adapter_active_profile() {
  local idx="$1" pair home_rel t name
  for pair in ${ADAPTER_LINKS[$idx]}; do
    home_rel="${pair#*:}"; home_rel="${home_rel%:*}"
    t="$(target_path "$home_rel")"
    if [ -L "$t" ] && name="$(profile_name_from_target "$(readlink_once "$t")")"; then
      printf '%s' "$name"
      return 0
    fi
  done
  return 1
}

# Point one target path at a profile, backing a real target up into the global
# profile first. Only call after adapter_can_link has approved the tool.
# $6 (optional): the profile this tool's links pointed at before the switch —
# the owner of any stray runtime state found at a managed path.
link_one() {
  local dir="$1" prof_rel="$2" home_rel="$3" type="$4" tool="$5" owner="${6:-}"
  local src="$dir/$prof_rel" tgt kind
  tgt="$(target_path "$home_rel")"
  kind="$(target_kind "$tgt")"

  case "$kind" in
    foreign)
      warn "$tool: $tgt is a symlink not managed by agman; leaving it alone"
      return 1 ;;
    real)
      local gdest="$GLOBAL_BACKUP/$prof_rel"
      if [ -e "$gdest" ]; then
        # The original is already backed up, so this real path is later
        # state, not the original — typically a tool that rewrote a managed
        # file in place (Claude Code replaces ~/.claude.json wholesale via
        # temp file + rename, which destroys the symlink). Absorb it rather
        # than wedging the tool forever: a single file goes to the profile a
        # sibling link still names (the freshest account state belongs to
        # it); anything else is kept aside untouched under $BACKUP_DIR. The
        # pristine global backup is never overwritten.
        if [ "$type" = "f" ] && [ -n "$owner" ] && [ -d "$(profile_dir "$owner")" ]; then
          if mv -f "$tgt" "$(profile_dir "$owner")/$prof_rel"; then
            warn "$tool: $tgt had become a real file (a tool rewrote it in place); moved the freshest copy into profile '$owner' and relinked"
          else
            warn "$tool: could not absorb $tgt into profile '$owner'"
            return 1
          fi
        else
          local stamp stray
          stamp="$(date +%Y%m%d%H%M%S 2>/dev/null || printf 'stray')"
          stray="$BACKUP_DIR/$prof_rel-stray-$stamp"
          mkdir -p "$BACKUP_DIR"
          if mv "$tgt" "$stray"; then
            warn "$tool: $tgt was a real path but the original is already backed up; kept this copy at $stray"
          else
            warn "$tool: could not move $tgt aside"
            return 1
          fi
        fi
      else
        mkdir -p "$GLOBAL_BACKUP"
        mv "$tgt" "$gdest" || { warn "$tool: could not back up $tgt"; return 1; }
        printf '%s\n' "$LAYOUT_VERSION" > "$GLOBAL_BACKUP/$LAYOUT_FILE"
      fi
      ;;
    agman)
      rm -f "$tgt" ;;
  esac

  ensure_profile_path "$src" "$type"
  ln -s "$src" "$tgt" || { warn "$tool: could not link $tgt"; return 1; }
  return 0
}

unlink_one() {
  local home_rel="$1" tgt
  tgt="$(target_path "$home_rel")"
  if [ "$(target_kind "$tgt")" = "agman" ]; then
    rm -f "$tgt"
    return 0
  fi
  return 1
}

# ---------------------------------------------------------------------------
# commands

cmd_create() {
  local name="" mode="empty" from="" link_plugins=0 arg src_json="" i=0 dir
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --empty) mode="empty" ;;
      --copy-current|--from-current) mode="current" ;;
      --from) [ $# -gt 0 ] || usage_die "--from requires a profile name"; from="$1"; shift; mode="clone" ;;
      --link-plugins) link_plugins=1 ;;
      -*) usage_die "unknown option '$arg' for create" ;;
      *) [ -z "$name" ] && name="$arg" || usage_die "unexpected argument '$arg'" ;;
    esac
  done
  require_creatable_name "$name"

  mkdir -p "$AGMAN_HOME"
  dir="$(profile_dir "$name")"
  [ ! -e "$dir" ] || die "profile '$name' already exists at $dir"
  mkdir "$dir"
  printf '%s\n' "$LAYOUT_VERSION" > "$dir/$LAYOUT_FILE"

  local tools=""
  case "$mode" in
    empty)
      write_starter_claude_md "$dir/claude" "$name"
      if src_json="$(identity_source)" && seed_identity "$src_json" "$dir/claude.json"; then
        tools="inherits your current Claude account"
      fi
      # Give every detected tool an empty tree so `use` manages it from the start.
      i=0
      while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
        if [ "${ADAPTER_NAMES[$i]}" != "claude" ] && adapter_in_scope "$i" ""; then
          mkdir -p "$dir/${ADAPTER_NAMES[$i]}"
        fi
        i=$((i + 1))
      done
      link_profile_identity "$dir"
      printf "Created profile '%s' at %s (empty, with a starter CLAUDE.md).\n" "$name" "$dir"
      if [ -n "$tools" ]; then
        printf "It %s, so no re-login is needed.\n" "$tools"
      else
        warn "could not read current account state; this profile may prompt for login"
      fi
      printf "Tip: use --copy-current to seed a profile from your current configs.\n"
      ;;
    current)
      i=0
      while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
        if adapter_in_scope "$i" ""; then
          local pair prof_rel home_rel type srcpath
          for pair in ${ADAPTER_LINKS[$i]}; do
            prof_rel="${pair%%:*}"
            home_rel="${pair#*:}"; type="${home_rel##*:}"; home_rel="${home_rel%:*}"
            srcpath="$(target_path "$home_rel")"
            if [ -L "$srcpath" ]; then srcpath="$(readlink_once "$srcpath")"; fi
            if [ "$type" = "d" ]; then
              seed_from_dir "$srcpath" "$dir/$prof_rel" "$link_plugins"
            elif [ -f "$srcpath" ]; then
              cp "$srcpath" "$dir/$prof_rel"
              chmod 600 "$dir/$prof_rel" 2>/dev/null || true
            fi
          done
          tools="$tools ${ADAPTER_NAMES[$i]}"
        fi
        i=$((i + 1))
      done
      if ! has_identity "$dir" && src_json="$(identity_source)"; then
        seed_identity "$src_json" "$dir/claude.json" || true
      fi
      [ -f "$dir/claude/CLAUDE.md" ] || write_starter_claude_md "$dir/claude" "$name"
      link_profile_identity "$dir"
      printf "Created profile '%s' at %s (copied from current configs:%s).\n" "$name" "$dir" "${tools:- none}"
      ;;
    clone)
      require_profile "$from"
      local fromdir; fromdir="$(profile_dir "$from")"
      [ "$(profile_layout "$fromdir")" = "1" ] && migrate_profile "$fromdir"
      local entry base
      while IFS= read -r -d '' entry; do
        base="${entry##*/}"
        [ "$base" = "$LAYOUT_FILE" ] && continue
        cp -R "$entry" "$dir/$base"
      done < <(find "$fromdir" -mindepth 1 -maxdepth 1 -print0)
      strip_account_material "$dir"
      printf "Created profile '%s' at %s (cloned from '%s').\n" "$name" "$dir" "$from"
      if profile_has_own_account "$fromdir"; then
        printf "The clone uses your shared Claude account; run 'agman login %s' to give it its own.\n" "$name"
      fi
      ;;
  esac
  printf "Switch to it with: agman use %s\n" "$name"
}

cmd_list() {
  [ -d "$AGMAN_HOME" ] || { printf "No profiles yet. Create one with: agman create <name>\n"; return 0; }
  local default_name="" active_name="" entry name marker suffix found=0 tools
  default_name="$(default_profile 2>/dev/null || true)"
  active_name="$(active_profile 2>/dev/null || true)"
  for entry in "$AGMAN_HOME"/*/; do
    [ -d "$entry" ] || continue
    found=1
    entry="${entry%/}"
    name="${entry##*/}"
    marker="  "
    [ "$name" = "$default_name" ] && marker="* "
    suffix=""
    if [ "$name" = "$active_name" ]; then
      tools="$(active_tools)"
      suffix="  (active: ${tools:-none})"
    fi
    [ "$(profile_layout "$entry")" = "1" ] && suffix="$suffix  [legacy layout]"
    printf '%s%s%s\n' "$marker" "$name" "$suffix"
  done
  [ "$found" = "1" ] || printf "No profiles yet. Create one with: agman create <name>\n"
}

# Arrow-key menu of profiles on the terminal; prints the chosen name on stdout.
# The menu itself is drawn on stderr so $(pick_profile) captures only the name.
pick_profile() {
  local names n=0 sel=0 i entry active key rest prev_stty
  names=()
  active="$(default_profile 2>/dev/null || true)"
  for entry in "$AGMAN_HOME"/*/; do
    [ -d "$entry" ] || continue
    entry="${entry%/}"
    names[$n]="${entry##*/}"
    [ "${names[$n]}" = "$active" ] && sel=$n
    n=$((n+1))
  done
  [ "$n" -gt 0 ] || die "no profiles yet. Create one with: agman create <name>"

  prev_stty="$(stty -g 2>/dev/null || true)"
  # shellcheck disable=SC2064  # expand prev_stty now, not at signal time
  trap "printf '\033[?25h' >&2; stty '$prev_stty' 2>/dev/null; printf '\nCancelled; nothing changed.\n' >&2; exit 130" INT TERM
  printf '\033[?25l' >&2
  printf 'Select a profile  (↑/↓ move, Enter select, q cancel)\n' >&2
  while :; do
    i=0
    while [ "$i" -lt "$n" ]; do
      if [ "$i" = "$sel" ]; then
        printf '\r\033[K\033[7m> %d  %s%s\033[0m\n' "$((i+1))" "${names[$i]}" \
          "$([ "${names[$i]}" = "$active" ] && printf '  (active)')" >&2
      else
        printf '\r\033[K  %d  %s%s\n' "$((i+1))" "${names[$i]}" \
          "$([ "${names[$i]}" = "$active" ] && printf '  (active)')" >&2
      fi
      i=$((i+1))
    done
    key=""
    IFS= read -rsn1 key || key="q"
    case "$key" in
      $'\033')
        rest=""
        IFS= read -rsn2 -t 1 rest || true
        case "$rest" in
          "[A"|"OA") key="up" ;;
          "[B"|"OB") key="down" ;;
          "") key="q" ;;
          *) key="" ;;
        esac ;;
    esac
    case "$key" in
      up|k)   [ "$sel" -gt 0 ] && sel=$((sel-1)) ;;
      down|j) [ "$sel" -lt $((n-1)) ] && sel=$((sel+1)) ;;
      [1-9])  [ "$key" -le "$n" ] && sel=$((key-1)) ;;
      ""|$'\n'|$'\r') break ;;
      q|Q)
        printf '\033[%dA\r\033[J\033[?25h' "$((n+1))" >&2
        trap - INT TERM
        printf 'Cancelled; nothing changed.\n' >&2
        return 1 ;;
    esac
    printf '\033[%dA' "$n" >&2
  done
  printf '\033[%dA\r\033[J\033[?25h' "$((n+1))" >&2
  trap - INT TERM
  printf '%s' "${names[$sel]}"
}

cmd_use() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    if [ -n "$(find_project_file "$PWD" 2>/dev/null)" ] || [ ! -t 0 ] || [ ! -t 2 ]; then
      name="$(resolve_project_profile)" || \
        usage_die "no profile given and no usable $PROJECT_FILE found here"
      printf "Using profile '%s' from %s.\n" "$name" "$(find_project_file "$PWD")"
    else
      name="$(pick_profile)" || exit $?
    fi
  fi
  require_profile "$name"

  # One-time migration of every profile to the multi-tool layout.
  migrate_all_profiles

  local dir; dir="$(profile_dir "$name")"
  local had_global=0
  [ -d "$GLOBAL_BACKUP" ] && had_global=1

  local i=0 pair prof_rel home_rel type linked="" skipped=""
  while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
    if adapter_in_scope "$i" "$dir"; then
      if adapter_can_link "$i"; then
        local ok=1 owner
        # Resolved before any relinking: the outgoing profile, which owns any
        # stray runtime state link_one finds at a managed path.
        owner="$(adapter_active_profile "$i")" || owner=""
        for pair in ${ADAPTER_LINKS[$i]}; do
          prof_rel="${pair%%:*}"
          home_rel="${pair#*:}"; type="${home_rel##*:}"; home_rel="${home_rel%:*}"
          link_one "$dir" "$prof_rel" "$home_rel" "$type" "${ADAPTER_NAMES[$i]}" "$owner" || ok=0
        done
        if [ "$ok" = "1" ]; then linked="$linked ${ADAPTER_NAMES[$i]}"
        else skipped="$skipped ${ADAPTER_NAMES[$i]}"; fi
      else
        skipped="$skipped ${ADAPTER_NAMES[$i]}"
      fi
    fi
    i=$((i + 1))
  done

  [ -n "${linked# }" ] || die "no tools could be activated for profile '$name'"

  # Claude account inheritance: promote credentials once, then make sure this
  # profile carries identity so switching never forces a re-login.
  if [ -d "$GLOBAL_BACKUP" ]; then
    adopt_shared_credentials "$GLOBAL_BACKUP"
    i=0
    while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
      if adapter_enabled "${ADAPTER_NAMES[$i]}"; then
        adopt_shared_state "$i" "$(profile_tool_dir "$GLOBAL_BACKUP" "$i")"
      fi
      i=$((i + 1))
    done
  fi
  local seeded=0 src_json=""
  if ! profile_has_own_account "$dir" && ! has_identity "$dir" && src_json="$(identity_source)"; then
    seed_identity "$src_json" "$(profile_identity_file "$dir")" && seeded=1
  fi
  link_shared_credentials "$dir"
  link_shared_state "$dir"
  link_profile_identity "$dir"
  refresh_api_key_helper "$dir"

  mkdir -p "$AGMAN_HOME"
  printf '%s\n' "$name" > "$DEFAULT_FILE"

  printf "Switched to profile '%s' (tools:%s).\n" "$name" "$linked"
  [ -n "$skipped" ] && warn "left alone:$skipped (see the warnings above)"
  if [ "$seeded" = "1" ]; then
    printf "Seeded this profile with your current Claude account (no re-login needed).\n"
  elif ! has_identity "$dir"; then
    warn "this profile has no saved account identity; Claude Code may prompt for login"
  fi
  if [ "$had_global" = "0" ] && [ -d "$GLOBAL_BACKUP" ]; then
    printf "Your original configs were backed up as the 'global' profile.\n"
    printf "Switch back with 'agman use global', or fully restore with 'agman off'.\n"
  fi
  printf "New sessions everywhere (including IDEs) now use this profile.\n"
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    warn "CLAUDE_CONFIG_DIR is set in this shell and overrides the switch here"
  fi
}

cmd_off() {
  local i=0 pair prof_rel home_rel type tgt restored="" kind
  while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
    for pair in ${ADAPTER_LINKS[$i]}; do
      prof_rel="${pair%%:*}"
      home_rel="${pair#*:}"; type="${home_rel##*:}"; home_rel="${home_rel%:*}"
      tgt="$(target_path "$home_rel")"
      kind="$(target_kind "$tgt")"
      [ "$kind" = "foreign" ] && warn "$tgt is a symlink not managed by agman; leaving it untouched"
      unlink_one "$home_rel" || true
      if [ -e "$GLOBAL_BACKUP/$prof_rel" ] && [ ! -e "$tgt" ]; then
        mv "$GLOBAL_BACKUP/$prof_rel" "$tgt" || warn "could not restore $tgt"
        restored="$restored ${ADAPTER_NAMES[$i]}"
        # The in-config-dir identity link points into the profile tree being
        # dismantled; ~/.claude.json is restored separately.
        if [ -L "$tgt/$IDENTITY_LINK" ]; then rm -f "$tgt/$IDENTITY_LINK"; fi
        # Leave the restored config self-contained: turn the shared credential
        # link back into a real file so it works without agman.
        if [ "$type" = "d" ] && [ -L "$tgt/$CREDS_BASENAME" ]; then
          rm -f "$tgt/$CREDS_BASENAME"
          if [ -f "$SHARED_CREDS" ]; then
            cp "$SHARED_CREDS" "$tgt/$CREDS_BASENAME"
            chmod 600 "$tgt/$CREDS_BASENAME" 2>/dev/null || true
            rm -f "$SHARED_CREDS"
          fi
        fi
      fi
    done
    i=$((i + 1))
  done

  # Give each restored config its shared state back as real paths.
  i=0
  while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
    for pair in ${ADAPTER_LINKS[$i]}; do
      case "$pair" in *:d) ;; *) continue ;; esac
      home_rel="${pair#*:}"; home_rel="${home_rel%:*}"
      tgt="$(target_path "$home_rel")"
      if [ -d "$tgt" ] && [ ! -L "$tgt" ]; then restore_shared_state "$i" "$tgt"; fi
    done
    prune_empty_state "$i"
    i=$((i + 1))
  done
  rmdir "$SHARED_STATE" 2>/dev/null || true

  # An emptied backup profile is just noise.
  if [ -d "$GLOBAL_BACKUP" ]; then
    rm -f "$GLOBAL_BACKUP/$LAYOUT_FILE"
    rmdir "$GLOBAL_BACKUP" 2>/dev/null || true
  fi
  rm -f "$DEFAULT_FILE"

  local leftovers; leftovers="$(list_conflict_leftovers)"
  if [ -n "$leftovers" ]; then
    warn "these copies were kept aside by an earlier merge and were not restored:"
    printf '%s\n' "$leftovers" | sed 's|^|  |' >&2
    warn "review them, then delete them by hand once you are satisfied"
  fi

  if [ -n "$restored" ]; then
    printf "Restored your original configs (%s) and stopped managing them.\n" "${restored# }"
  else
    printf "Nothing was active. Your configs are untouched.\n"
  fi
}

cmd_current() {
  local name tools
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    if name="$(profile_name_from_target "$CLAUDE_CONFIG_DIR")"; then
      printf '%s  (via CLAUDE_CONFIG_DIR in this shell)\n' "$name"
    else
      printf '(external dir via CLAUDE_CONFIG_DIR: %s)\n' "$CLAUDE_CONFIG_DIR"
    fi
    return 0
  fi
  if name="$(active_profile)"; then
    tools="$(active_tools)"
    printf '%s  (active for: %s)\n' "$name" "${tools:-none}"
    return 0
  fi
  printf 'none  (no profile active; your configs are unmanaged)\n'
}

cmd_dir() {
  local arg="${1:-}" name dir
  if [ "$arg" = "--for-cwd" ]; then
    name="$(resolve_project_profile quiet)" || exit 1
    dir="$(profile_dir "$name")"
    [ -d "$dir" ] || exit 1
    link_profile_identity "$dir" >/dev/null 2>&1 || true
    printf '%s\n' "$(profile_claude_dir "$dir")"
    return 0
  fi
  if [ "$arg" = "--active" ]; then
    name="$(default_profile)" || exit 1
    dir="$(profile_dir "$name")"
    [ -d "$dir" ] || exit 1
    printf '%s\n' "$(profile_claude_dir "$dir")"
    return 0
  fi
  require_profile "$arg"
  printf '%s\n' "$(profile_claude_dir "$(profile_dir "$arg")")"
}

cmd_env() {
  local name="${1:-}"
  require_profile "$name"
  local dir; dir="$(profile_dir "$name")"
  link_profile_identity "$dir"
  local i=0 pair prof_rel envvar emitted=0
  while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
    envvar="${ADAPTER_ENVVARS[$i]}"
    if [ "$envvar" != "-" ] && adapter_in_scope "$i" "$dir"; then
      for pair in ${ADAPTER_LINKS[$i]}; do
        prof_rel="${pair%%:*}"
        case "$pair" in *:d) ;; *) continue ;; esac
        printf 'export %s=%q\n' "$envvar" "$dir/$prof_rel"
        emitted=1
        break
      done
    elif [ "$envvar" = "-" ] && adapter_in_scope "$i" "$dir"; then
      printf '# %s has no config-dir environment variable; use `agman use %s`\n' \
        "${ADAPTER_LABELS[$i]}" "$name"
    fi
    i=$((i + 1))
  done
  [ "$emitted" = "1" ] || warn "no tool in profile '$name' supports a per-shell override"
}

# Escape a string for inclusion in a JSON double-quoted string literal.
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# --settings flag that keeps the machine-active profile's memory out of a
# launch of another profile: from the home directory Claude Code reads
# <cwd>/.claude/CLAUDE.md and <cwd>/.claude/rules/** as project memory, and
# ~/.claude is the active profile's tree. Names both the path Claude computes
# and the directory it points at. Prints nothing when the launch targets the
# active profile itself.
memory_exclude_args() {
  local dir="$1" active p out=""
  dir="$(cd "$dir" 2>/dev/null && pwd -P)" || return 0
  active="$(target_path .claude)"
  if [ -L "$active" ]; then active="$(readlink_once "$active")"; fi
  active="$(cd "$active" 2>/dev/null && pwd -P)" || return 0
  [ "$active" != "$dir" ] || return 0
  for p in "$TARGET_HOME/.claude/CLAUDE.md" "$TARGET_HOME/.claude/rules/**" "$active/CLAUDE.md" "$active/rules/**"; do
    # Git Bash: Claude Code matches native C:/… paths, not /c/… ones.
    command -v cygpath >/dev/null 2>&1 && p="$(cygpath -m "$p")"
    out="${out:+$out,}\"$(json_escape "$p")\""
  done
  printf '%s' "--settings={\"claudeMdExcludes\":[$out]}"
}

# The user's own --settings wins: agman never overrides it, and merging two
# flag settings is not worth the surprise. Prints nothing when clean.
memory_exclude_guard() {
  local a
  for a in ${1+"$@"}; do
    case "$a" in
      --settings|--settings=*) return 1 ;;
    esac
  done
  return 0
}

cmd_run() {
  local name="${1:-}"
  if [ -z "$name" ] || [ "$name" = "--" ]; then
    name="$(resolve_project_profile)" || \
      usage_die "no profile given and no usable $PROJECT_FILE found here"
    [ "${1:-}" = "--" ] || set -- "$name" ${1+"$@"}
  fi
  require_profile "$name"
  link_profile_identity "$(profile_dir "$name")"
  shift
  [ "${1:-}" = "--" ] && shift
  if stealth_is_enabled "$name"; then
    stealth_claude --profile "$name" -- ${1+"$@"}
    return
  fi
  command -v claude >/dev/null 2>&1 || die "claude CLI not found on PATH"
  local dir memargs=""
  dir="$(profile_dir "$name")"
  if memory_exclude_guard ${1+"$@"}; then
    memargs="$(memory_exclude_args "$(profile_claude_dir "$dir")")"
  fi
  exec env CLAUDE_CONFIG_DIR="$(profile_claude_dir "$dir")" claude ${memargs:+"$memargs"} ${1+"$@"}
}

cmd_exec() {
  local name="${1:-}"
  require_profile "$name"
  link_profile_identity "$(profile_dir "$name")"
  shift
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || usage_die "exec requires a command: agman exec <name> -- <command...>"
  local dir; dir="$(profile_dir "$name")"
  exec env CLAUDE_CONFIG_DIR="$(profile_claude_dir "$dir")" \
           CODEX_HOME="$dir/codex" "$@"
}

cmd_rename() {
  local old="${1:-}" new="${2:-}"
  require_profile "$old"
  require_creatable_name "$new"
  [ ! -e "$(profile_dir "$new")" ] || die "profile '$new' already exists"
  local was_active=0
  [ "$(active_profile 2>/dev/null || true)" = "$old" ] && was_active=1
  mv "$(profile_dir "$old")" "$(profile_dir "$new")"
  stealth_rename_profile "$old" "$new"
  if [ "$(default_profile 2>/dev/null || true)" = "$old" ]; then
    printf '%s\n' "$new" > "$DEFAULT_FILE"
  fi
  if [ "$was_active" = "1" ]; then
    local dir; dir="$(profile_dir "$new")"
    local i=0 pair prof_rel home_rel type tgt
    while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
      for pair in ${ADAPTER_LINKS[$i]}; do
        prof_rel="${pair%%:*}"
        home_rel="${pair#*:}"; type="${home_rel##*:}"; home_rel="${home_rel%:*}"
        tgt="$(target_path "$home_rel")"
        if [ "$(target_kind "$tgt")" = "agman" ]; then
          rm -f "$tgt"
          ensure_profile_path "$dir/$prof_rel" "$type"
          ln -s "$dir/$prof_rel" "$tgt"
        fi
      done
      i=$((i + 1))
    done
  fi
  printf "Renamed profile '%s' to '%s'.\n" "$old" "$new"
}

cmd_remove() {
  local name="" yes=0 arg
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      -y|--yes) yes=1 ;;
      -*) usage_die "unknown option '$arg' for remove" ;;
      *) [ -z "$name" ] && name="$arg" || usage_die "unexpected argument '$arg'" ;;
    esac
  done
  require_profile "$name"
  if [ "$(active_profile 2>/dev/null || true)" = "$name" ]; then
    die "profile '$name' is active. Switch away first: agman use <other> or agman off"
  fi
  local dir; dir="$(profile_dir "$name")"
  if [ "$yes" != "1" ]; then
    printf "Delete profile '%s' and everything in %s? [y/N] " "$name" "$dir"
    local reply=""
    IFS= read -r reply || true
    case "$reply" in y|Y|yes|YES) ;; *) printf 'Aborted.\n'; return 1 ;; esac
  fi
  rm -rf "$dir"
  stealth_forget_profile "$name"
  if [ "$(default_profile 2>/dev/null || true)" = "$name" ]; then
    rm -f "$DEFAULT_FILE"
  fi
  printf "Removed profile '%s'.\n" "$name"
  if [ "$name" = "global" ]; then
    warn "'global' held the backup of your original configs; 'agman off' can no longer restore them"
  fi
}

cmd_doctor() {
  printf 'agman %s\n' "$AGMAN_VERSION"
  printf 'profiles home: %s\n' "$AGMAN_HOME"
  printf 'layout:        version %s\n' "$LAYOUT_VERSION"

  printf '\ntools:\n'
  local i=0 pair home_rel tgt cmdpath
  while [ "$i" -lt "${#ADAPTER_NAMES[@]}" ]; do
    cmdpath="$(command -v "${ADAPTER_CMDS[$i]}" 2>/dev/null || printf 'not installed')"
    printf '  %-8s %-14s cli: %s\n' "${ADAPTER_NAMES[$i]}" "${ADAPTER_LABELS[$i]}" "$cmdpath"
    for pair in ${ADAPTER_LINKS[$i]}; do
      home_rel="${pair#*:}"; home_rel="${home_rel%:*}"
      tgt="$(target_path "$home_rel")"
      printf '           %-22s %s\n' "$home_rel" "$(target_kind "$tgt")"
    done
    if [ "${ADAPTER_ENVVARS[$i]}" = "-" ]; then
      printf '           %-22s none (symlink switching only)\n' "env override"
    fi
    i=$((i + 1))
  done

  local count=0 entry
  if [ -d "$AGMAN_HOME" ]; then
    for entry in "$AGMAN_HOME"/*/; do
      [ -d "$entry" ] && count=$((count + 1))
    done
  fi
  printf '\nprofiles:      %s\n' "$count"

  local name
  if name="$(active_profile 2>/dev/null)"; then
    printf 'active:        %s (tools: %s)\n' "$name" "$(active_tools)"
  else
    printf 'active:        none\n'
  fi

  if [ -d "$GLOBAL_BACKUP" ]; then
    printf "backup:        original configs preserved as profile 'global'\n"
  else
    printf 'backup:        none (originals are in place or were never migrated)\n'
  fi

  if name="$(default_profile 2>/dev/null)"; then
    if [ -d "$(profile_dir "$name")" ]; then
      printf 'default:       %s\n' "$name"
    else
      printf 'default:       %s (STALE — directory missing; run: agman off)\n' "$name"
    fi
  else
    printf 'default:       none\n'
  fi

  if [ -f "$SHARED_CREDS" ]; then
    printf 'credentials:   shared file at %s (profiles symlink to it)\n' "$SHARED_CREDS"
  else
    printf 'credentials:   no shared file (normal on macOS, where Claude Code uses the Keychain)\n'
  fi
  printf 'json merge:    %s\n' "$(json_tool)"
  local linked_profiles leftovers
  linked_profiles="$(count_shared_linked_profiles)"
  if share_state_enabled; then
    if [ -d "$SHARED_STATE" ]; then
      printf 'session state: shared at %s\n' "$SHARED_STATE"
      printf '               %s project dirs, %s profile(s) linked — claude --resume\n' \
        "$(ls "$SHARED_STATE/projects" 2>/dev/null | wc -l | tr -d ' ')" "$linked_profiles"
      printf '               works across profiles\n'
    else
      printf 'session state: shared on next switch\n'
    fi
  elif [ "$linked_profiles" != "0" ]; then
    printf 'session state: AGMAN_SHARE_STATE=0, but %s profile(s) still point at\n' "$linked_profiles"
    printf '               %s. Existing links are left alone; run\n' "$SHARED_STATE"
    printf "               'agman off' to hand the history back before unsharing.\n"
  else
    printf 'session state: per-profile (AGMAN_SHARE_STATE=0)\n'
  fi
  leftovers="$(list_conflict_leftovers)"
  if [ -n "$leftovers" ]; then
    printf 'kept aside:    copies a merge could not place (nothing was deleted):\n'
    printf '%s\n' "$leftovers" | sed 's|^|               |'
  fi

  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    printf 'env override:  CLAUDE_CONFIG_DIR=%s (wins over the symlink in this shell)\n' "$CLAUDE_CONFIG_DIR"
  else
    printf 'env override:  not set in this shell\n'
  fi

  if [ -d "$AGMAN_HOME" ]; then
    local any=0
    for entry in "$AGMAN_HOME"/*/; do
      [ -d "$entry" ] || continue
      [ "$any" = "0" ] && printf '\nper-profile auth:\n' && any=1
      entry="${entry%/}"
      printf '  %-20s %s' "${entry##*/}" "$(profile_auth_state "$entry")"
      if profile_has_identity_drift "$entry"; then
        printf ', IDENTITY DRIFT'
      elif [ -L "$(profile_identity_link "$entry")" ]; then
        printf ', identity linked'
      else
        printf ', identity not linked (run: agman use %s)' "${entry##*/}"
      fi
      [ "$(profile_layout "$entry")" = "1" ] && printf ' [legacy layout]'
      printf '\n'
    done
  fi

  local tmp
  tmp="$(mktemp -d)"
  if ln -s "$tmp" "$tmp/link-test" 2>/dev/null; then
    printf '\nsymlinks:      supported\n'
  else
    printf '\nsymlinks:      NOT supported (agman use cannot work on this filesystem)\n'
  fi
  rm -rf "$tmp"

  local pf
  if pf="$(find_project_file "$PWD" 2>/dev/null)"; then
    printf '\nproject file:  %s\n' "$pf"
    printf '               profile: %s, trusted: %s\n' \
      "$(read_project_profile "$pf" 2>/dev/null || printf '(none)')" \
      "$(project_is_trusted "$pf" && printf yes || printf 'no — agman use will ask')"
  fi

  printf '\nnotes:\n'
  printf '  - Switching is symlink-based, so it applies to every new session on\n'
  printf '    this machine, including IDE extensions.\n'
  printf '  - Gemini CLI has no config-dir environment variable, so symlink\n'
  printf '    switching is the only way to profile it.\n'
}

cmd_login() {
  local name="" from_stdin=0 no_run=0 arg token="" rc
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --token-stdin) from_stdin=1 ;;
      --no-run) no_run=1 ;;
      -*) usage_die "unknown option '$arg' for login" ;;
      *) [ -z "$name" ] && name="$arg" || usage_die "unexpected argument '$arg'" ;;
    esac
  done
  require_profile "$name"
  local dir; dir="$(profile_dir "$name")"
  [ "$(profile_layout "$dir")" = "1" ] && migrate_profile "$dir"

  if [ "$from_stdin" = "1" ]; then
    IFS= read -r token || true
  else
    [ -t 0 ] || die "not a terminal; pipe a token instead: agman login $name --token-stdin"
    printf "Giving profile '%s' its own Claude account.\n\n" "$name"
    printf "This needs a long-lived token from 'claude setup-token', which opens a\n"
    printf "browser and prints a token once (valid one year, and it does not rotate).\n\n"
    if [ "$no_run" = "0" ] && command -v claude >/dev/null 2>&1; then
      printf "Running 'claude setup-token' now — approve the account you want for this profile.\n\n"
      claude setup-token || warn "'claude setup-token' did not finish cleanly; you can still paste a token below"
      printf "\n"
    else
      printf "Run this in another terminal, then come back:\n  claude setup-token\n\n"
    fi
    printf 'Paste the token (input hidden): '
    if command -v stty >/dev/null 2>&1; then
      stty -echo 2>/dev/null || true
      IFS= read -r token || true
      stty echo 2>/dev/null || true
      printf '\n'
    else
      IFS= read -r token || true
    fi
  fi

  # Strip whitespace without ever echoing the value.
  token="$(printf '%s' "$token" | tr -d '[:space:]')"
  [ -n "$token" ] || die "no token provided; nothing changed"
  case "$token" in
    sk-ant-oat*) ;;
    *) warn "token does not look like a 'claude setup-token' value (expected sk-ant-oat…); storing it anyway" ;;
  esac

  local tf; tf="$(profile_token_file "$dir")"
  mkdir -p "$(profile_claude_dir "$dir")"
  ( umask 177; printf '%s\n' "$token" > "$tf" )
  chmod 600 "$tf" 2>/dev/null || true

  rc=0
  write_api_key_helper "$dir" || rc=$?
  if [ "$rc" = "2" ]; then
    rm -f "$tf" "$(profile_helper_file "$dir")"
    die "cannot merge apiKeyHelper into $(profile_settings_file "$dir") without jq or python3; install one and retry"
  elif [ "$rc" != "0" ]; then
    rm -f "$tf" "$(profile_helper_file "$dir")"
    die "could not write apiKeyHelper to $(profile_settings_file "$dir")"
  fi

  # The seeded identity describes the shared account, which would make /status
  # show the wrong email for this profile. Keep the onboarding flag, drop the
  # account metadata.
  json_del_keys "$(profile_identity_file "$dir")" oauthAccount userID || true

  printf "\nProfile '%s' now authenticates with its own account.\n" "$name"
  printf "  token:  %s (mode 600, never synced)\n" "$tf"
  printf "  helper: %s (called by Claude Code as apiKeyHelper)\n" "$(profile_helper_file "$dir")"
  printf "\nThis applies to the CLI, the VS Code extension, and the Agent SDK.\n"
  printf "Undo with: agman logout %s\n" "$name"
  printf "\nKnown limits of setup-token credentials:\n"
  printf "  - requires a Pro, Max, Team, or Enterprise plan\n"
  printf "  - model requests only: no Remote Control, no claude.ai connectors\n"
  printf "    (locally configured MCP servers still work)\n"
  printf "  - managed setups pinning forceLoginOrgUUID reject environment credentials\n"
  printf "  - expires after about a year; rerun this command to replace it\n"
}

cmd_logout() {
  local name="${1:-}" rc
  require_profile "$name"
  local dir; dir="$(profile_dir "$name")"
  if ! profile_has_own_account "$dir" && [ ! -f "$(profile_helper_file "$dir")" ]; then
    printf "Profile '%s' has no account of its own; nothing to do.\n" "$name"
    return 0
  fi
  rc=0
  remove_api_key_helper "$dir" || rc=$?
  [ "$rc" = "2" ] && warn "removed the token and helper, but could not edit $(profile_settings_file "$dir") without jq or python3; delete its apiKeyHelper line by hand"

  # Restore the shared account's identity so the profile stops prompting.
  local src_json=""
  if src_json="$(identity_source)"; then
    seed_identity "$src_json" "$(profile_identity_file "$dir")" || true
  fi
  printf "Profile '%s' is back on your shared Claude account.\n" "$name"
}

cmd_migrate() {
  [ -d "$AGMAN_HOME" ] || die "no profiles to migrate"
  local before after
  before="$(active_profile 2>/dev/null || true)"
  migrate_all_profiles
  after="$(profile_layout "$GLOBAL_BACKUP" 2>/dev/null || printf '%s' "$LAYOUT_VERSION")"
  if [ -n "$before" ]; then
    printf "Re-linking the active profile '%s'.\n" "$before"
    cmd_use "$before" >/dev/null
    printf "Done. Active profile relinked to the new layout.\n"
  else
    printf "Done. Layout version %s.\n" "$LAYOUT_VERSION"
  fi
  [ -n "$after" ] || true
}

cmd_update() {
  local self target dir tmp new_ver
  self="${BASH_SOURCE[0]:-$0}"
  if [ -L "$self" ]; then
    target="$(readlink_once "$self")"
    case "$target" in
      /*) self="$target" ;;
      *)  self="$(dirname "$self")/$target" ;;
    esac
  fi
  dir="$(cd "$(dirname "$self")" && pwd -P)"
  self="$dir/$(basename "$self")"

  if [ -d "$dir/../.git" ] && command -v git >/dev/null 2>&1; then
    printf 'Updating from git checkout: %s\n' "$(cd "$dir/.." && pwd -P)"
    git -C "$dir/.." pull --ff-only || die "git pull failed; resolve manually"
    new_ver="$(grep -m1 '^AGMAN_VERSION=' "$self" | cut -d'"' -f2 || true)"
    printf 'agman updated: %s -> %s\n' "$AGMAN_VERSION" "${new_ver:-unknown}"
    return 0
  fi

  command -v curl >/dev/null 2>&1 || die "curl is required for self-update"
  tmp="$(mktemp "$dir/.agman-update.XXXXXX")" || die "cannot write to $dir (try with appropriate permissions)"
  if ! curl -fsSL "$AGMAN_RAW_URL/bin/agman" -o "$tmp"; then
    rm -f "$tmp"
    die "download failed from $AGMAN_RAW_URL"
  fi
  if ! bash -n "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    die "downloaded file failed validation; keeping current version"
  fi
  new_ver="$(grep -m1 '^AGMAN_VERSION=' "$tmp" | cut -d'"' -f2 || true)"
  chmod +x "$tmp"
  mv "$tmp" "$self" || { rm -f "$tmp"; die "cannot replace $self (permissions?)"; }
  printf 'agman updated: %s -> %s (%s)\n' "$AGMAN_VERSION" "${new_ver:-unknown}" "$self"
}

cmd_init() {
  local shell="${1:-auto}"
  if [ "$shell" = "auto" ]; then
    shell="${SHELL:-bash}"
    shell="${shell##*/}"
  fi
  case "$shell" in
    zsh|bash) ;;
    *) die "unsupported shell '$shell' (zsh and bash are supported; fish is on the roadmap)" ;;
  esac
  cat <<'AGMAN_SNIPPET'
# >>> agman shell integration (optional) >>>
# Switching profiles works without this — `agman use` swaps config paths via
# symlink. This hook adds per-shell behavior on top: `use`/`off` also
# export/unset CLAUDE_CONFIG_DIR so the current shell can diverge from the
# machine-wide profile.
export AGMAN_SHELL_INTEGRATION=1

agman() {
  case "${1:-}" in
    use)
      command agman "$@" || return $?
      local _agman_a _agman_dir
      for _agman_a in "$@"; do case "$_agman_a" in -h|--help) return 0 ;; esac; done
      if _agman_dir="$(command agman dir --active 2>/dev/null)" && [ -n "$_agman_dir" ]; then
        export CLAUDE_CONFIG_DIR="$_agman_dir"
      fi
      ;;
    off)
      command agman "$@" || return $?
      unset CLAUDE_CONFIG_DIR
      ;;
    *)
      command agman "$@"
      ;;
  esac
}

# Per-directory profiles: when a trusted .agman file applies to the current
# directory, point this shell at the profile it names. Only ever touches
# CLAUDE_CONFIG_DIR that this hook set itself, so a manual export always wins.
# Terminal only — IDE extensions do not inherit a shell's environment.
_agman_autoswitch() {
  local _agman_dir
  _agman_dir="$(command agman dir --for-cwd 2>/dev/null || true)"
  if [ -n "$_agman_dir" ]; then
    if [ "${CLAUDE_CONFIG_DIR:-}" != "$_agman_dir" ] &&
       { [ -z "${CLAUDE_CONFIG_DIR:-}" ] || [ -n "${AGMAN_AUTO_DIR:-}" ]; }; then
      export CLAUDE_CONFIG_DIR="$_agman_dir" AGMAN_AUTO_DIR="$_agman_dir"
    fi
  elif [ -n "${AGMAN_AUTO_DIR:-}" ]; then
    unset CLAUDE_CONFIG_DIR AGMAN_AUTO_DIR
  fi
}

if [ -n "${ZSH_VERSION:-}" ]; then
  autoload -Uz add-zsh-hook 2>/dev/null && add-zsh-hook chpwd _agman_autoswitch
else
  case "${PROMPT_COMMAND:-}" in
    *_agman_autoswitch*) ;;
    *) PROMPT_COMMAND="_agman_autoswitch${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
  esac
fi
_agman_autoswitch

claude() {
  # A profile with `agman stealth enable` always launches through the proxy.
  if command agman stealth enabled 2>/dev/null; then
    command agman stealth claude -- "$@"
    return $?
  fi
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    command claude "$@"
    return $?
  fi
  local _agman_dir
  if _agman_dir="$(command agman dir --active 2>/dev/null)" && [ -n "$_agman_dir" ]; then
    CLAUDE_CONFIG_DIR="$_agman_dir" command claude "$@"
  else
    command claude "$@"
  fi
}
# <<< agman shell integration <<<
AGMAN_SNIPPET
}

# ---------------------------------------------------------------------------
# cloud sync
#
# `agman cloud` syncs profile config trees with an agman cloud server
# (github.com/memandip/agman-cloud): versioned push/pull over HTTPS, content
# encrypted at rest server-side. Requires curl + tar; nothing else.
#
# Safety model (load-bearing; each rule is exercised by tests/run.sh):
#   - A synced profile is a persona, not a login. Push excludes account
#     material (the identity file claude.json/.claude.json, .credentials.json,
#     the per-profile token and apiKey helper, codex auth.json, gemini
#     oauth_creds.json / google_accounts.json, any .env) AND ephemeral or
#     machine-local state (SEED_EXCLUDES: sessions, projects, history, caches,
#     logs, ide locks, paste-cache, …). The same names are stripped on pull.
#     --include-secrets (push) / --with-secrets (pull) opt into carrying the
#     account material for your own machine-to-machine restore.
#   - Reinstallable plugin artifacts (plugin caches, marketplace clones,
#     catalog data) are never synced; their references are, and pull
#     reinstalls them into the pulled tree via the claude CLI
#     (AGMAN_CLOUD_NO_INSTALL=1 skips the reinstall). Dependency artifacts
#     (.venv/venv, node_modules, __pycache__, .git) are likewise never synced:
#     sources next to them are, and the artifacts are rebuilt on the target
#     machine (pip install / npm install / git clone).
#   - Push refuses when a synced file contains an obvious secret (API keys,
#     private keys) unless --force / --include-secrets — a blocklist can't see
#     a token pasted into settings.json, so content is scanned too.
#   - Pull treats a downloaded profile as untrusted: it strips hooks and
#     apiKeyHelper from settings.json (arbitrary-code / wrong-account vectors)
#     unless --with-secrets, never overwrites the shared-state symlinks or the
#     identity link, backs up an existing profile before overwriting, and
#     refuses the active profile without --force.
#   - The API key is passed to curl via a mode-600 config file, never on the
#     command line; plain http:// is refused unless AGMAN_CLOUD_INSECURE=1.

# Ephemeral / machine-local names never synced in either direction. Built from
# SEED_EXCLUDES (the vetted "don't clone this between profiles" set) minus the
# credential names, which are handled separately so --include-secrets can opt
# them back in, plus machine-local identity files that mean nothing on another
# machine (gemini installation_id / trustedFolders.json, the codex
# personality-migration marker) but are fine to clone locally, plus
# reinstallable dependency artifacts (virtualenvs, node_modules, bytecode
# caches, the .git of a cloned MCP server). Those artifacts are cloud-only
# exclusions: local clones keep them because the active profile is always
# symlinked at the tool's real config path, so copied venvs still run.
CLOUD_STATE_NAMES="antigravity antigravity-browser-profile backups cache downloads file-history history ide locks log logs paste-cache projects session-env sessions shell-snapshots statsig tasks telemetry tmp .tmp todos history.jsonl mcp-needs-auth-cache.json .last-cleanup .DS_Store installation_id trustedFolders.json .personality_migration .git .venv venv node_modules __pycache__"
# Account material: excluded by default, opt-in via --include-secrets/--with-secrets.
CLOUD_SECRET_NAMES=".credentials.json $TOKEN_BASENAME $HELPER_BASENAME auth.json oauth_creds.json google_accounts.json .env claude.json $IDENTITY_LINK"
# Content patterns that mark an obvious secret pasted into an otherwise
# syncable file (mirrors the agman-cloud server's own scan).
CLOUD_SECRET_RE='-----BEGIN [A-Z ]*PRIVATE KEY-----|sk-ant-[A-Za-z0-9_-]{16,}|sk-proj-[A-Za-z0-9_-]{16,}|AIza[0-9A-Za-z_-]{35}|gh[pousr]_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}'
# Reinstallable Claude Code plugin artifacts (marketplace clones, catalog
# data; the cache dir is already dropped by the 'cache' state name): never
# synced in either direction. The references that recreate them —
# settings.json enabledPlugins, plugins/known_marketplaces.json,
# plugins/installed_plugins.json — are synced, and pull reinstalls from them
# (cloud_install_plugins). Mirrors the agman-cloud server's own filter and
# the reference client's tar excludes; keep the three in sync.
CLOUD_PLUGIN_ARTIFACT_RE='(^|/)plugins/(cache|marketplaces|repos|data)(/|$)|(^|/)plugins/plugin-catalog-cache\.json$'
# agman's own shared-state merge leftovers (adopt_shared_state parks colliding
# copies as <name>.agman-conflict / <name>.agman-orphaned): machine-local
# transcripts and history, never synced in either direction. A suffix can't be
# expressed in the component-name lists above, hence the regex.
CLOUD_LEFTOVER_RE='(^|/)[^/]+\.agman-(conflict|orphaned)(/|$)'
# Fallback cap on a compressed push payload, used when the server does not
# advertise its own (maxPushBytes in GET /api/profiles; older agman-cloud
# releases don't send it). Checking client-side before the PUT turns an
# opaque HTTP failure into a diagnosis. AGMAN_CLOUD_MAX_PUSH_BYTES overrides
# both this default and an advertised limit.
CLOUD_MAX_PUSH_BYTES_DEFAULT=26214400

cloud_require_curl() {
  command -v curl >/dev/null 2>&1 || die "curl is required for cloud sync"
}

# Temp files/dirs of a cloud command, removed on normal exit or a signal so a
# secret-bearing archive is never stranded. Tracked in a global (not a per-
# function local) so the EXIT trap can still see the paths at process scope.
AGMAN_CLOUD_TMP=""
cloud_track() { AGMAN_CLOUD_TMP="$AGMAN_CLOUD_TMP $1"; }
cloud_cleanup() { local f; for f in $AGMAN_CLOUD_TMP; do rm -rf "$f"; done; return 0; }

cloud_lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# Verbose diagnostics (`agman cloud --verbose …` or AGMAN_VERBOSE=1): a few
# high-signal lines on stderr — the request line, the push payload size, the
# response code. Deliberately terse; this is not a debug trace.
cloud_log() {
  [ "${AGMAN_VERBOSE:-0}" = "1" ] && printf 'cloud: %s\n' "$1" >&2
  return 0
}

# Transfer progress for byte-heavy requests: curl's compact bar on stderr.
# Auto-detected — on only when stderr is a terminal, so scripts, CI, and
# captured output stay clean. AGMAN_PROGRESS=1 forces it on, =0 off.
cloud_progress_enabled() {
  case "${AGMAN_PROGRESS:-}" in
    1) return 0 ;;
    0) return 1 ;;
  esac
  [ -t 2 ]
}

# Build (^|/)(a|b|c)(/|$) matching any listed name as a full path component.
# Dots are escaped so 'history.jsonl' can't match 'historyXjsonl'.
cloud_name_re() {
  local acc="" n esc
  for n in $1; do
    esc="${n//./\\.}"
    acc="${acc:+$acc|}$esc"
  done
  printf '(^|/)(%s)(/|$)' "$acc"
}

cloud_url=""
cloud_key=""
cloud_load() {
  [ -f "$CLOUD_FILE" ] || die "not logged in to agman cloud (run 'agman cloud login')"
  cloud_url=""; cloud_key=""
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      url=*) cloud_url="${line#url=}" ;;
      key=*) cloud_key="${line#key=}" ;;
    esac
  done < "$CLOUD_FILE"
  if [ -z "$cloud_url" ] || [ -z "$cloud_key" ]; then
    die "cloud credentials at $CLOUD_FILE are incomplete; run 'agman cloud login' again"
  fi
}

# cloud_http [--progress] <method> <path> <body-out-file> [curl args...];
# prints HTTP code. With --progress, curl draws its transfer bar on stderr
# (which stays live for that call) — for byte-heavy requests only.
# The API key goes in a mode-600 curl config file (-K), never on the command
# line where `ps` could read it. mktemp creates the file 0600 already.
cloud_http() {
  local progress=0
  if [ "${1:-}" = "--progress" ]; then progress=1; shift; fi
  local method="$1" path="$2" out="$3" code cfg
  shift 3
  cloud_log "$method $cloud_url$path"
  cfg="$(mktemp)"; cloud_track "$cfg"
  printf 'header = "x-api-key: %s"\n' "$cloud_key" > "$cfg"
  # curl prints '000' itself when it never got a response; keep any real code
  # it did receive before a mid-transfer failure instead of masking it.
  if [ "$progress" = "1" ]; then
    code="$(curl --progress-bar -K "$cfg" -X "$method" --connect-timeout 10 \
      -o "$out" -w '%{http_code}' "$cloud_url$path" ${1+"$@"})" || true
  else
    code="$(curl -sS -K "$cfg" -X "$method" --connect-timeout 10 \
      -o "$out" -w '%{http_code}' "$cloud_url$path" ${1+"$@"} 2>/dev/null)" || true
  fi
  rm -f "$cfg"
  [ -n "$code" ] || code="000"
  cloud_log "HTTP $code"
  printf '%s' "$code"
}

# Best-effort {"error":"..."} extraction from a JSON response body.
cloud_error_from() { sed -n 's/.*"error":"\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -1; }

cloud_die_http() {
  local code="$1" msg="${2:-}"
  case "$code" in
    000) die "cloud: cannot reach $cloud_url" ;;
    401) die "cloud: API key rejected; run 'agman cloud login' again" ;;
    413) die "cloud: the server rejected the payload as too large${msg:+: $msg}. Without a server message, its hosting platform refused the request before the app ran. Run 'agman cloud push --dry-run' to see what a push carries, and trim the profile" ;;
    *)   die "cloud: HTTP $code${msg:+: $msg}" ;;
  esac
}

# Files of a profile tree to push, one relative path per line. Always drops
# ephemeral/machine-local state; drops account material unless keep_secrets=1.
# find -type f skips symlinks (shared-state links, identity link); grep drops
# excluded path components, so real state files are excluded even when
# AGMAN_SHARE_STATE=0 made them regular files.
cloud_push_files() {
  local dir="$1" keep_secrets="$2" names re
  names="$CLOUD_STATE_NAMES"
  [ "$keep_secrets" = "1" ] || names="$names $CLOUD_SECRET_NAMES"
  re="$(cloud_name_re "$names")"
  ( cd "$dir" && find . -type f | grep -Ev "$re" | grep -Ev "$CLOUD_PLUGIN_ARTIFACT_RE" \
    | grep -Ev "$CLOUD_LEFTOVER_RE" ) || true
}

# Whole MB with one decimal place, integer arithmetic only (no bc/awk).
cloud_mb() { printf '%d.%d' "$(($1 / 1048576))" "$((($1 % 1048576) * 10 / 1048576))"; }

# "<bytes> <path>" per file in $list (relative to $dir), largest first — the
# diagnostic listing behind push --dry-run and the oversize refusal.
cloud_sized_listing() {
  local dir="$1" list="$2" f
  ( cd "$dir" && printf '%s\n' "$list" | while IFS= read -r f; do
      [ -n "$f" ] && [ -f "$f" ] || continue
      printf '%s %s\n' "$(wc -c < "$f" | tr -d ' ')" "${f#./}"
    done ) | sort -rn
}

# Print files (relative to $dir) from $list whose content matches an obvious
# secret pattern. -I skips binaries.
cloud_scan_content() {
  local dir="$1" list="$2" f
  ( cd "$dir" && printf '%s\n' "$list" | while IFS= read -r f; do
      [ -n "$f" ] && [ -f "$f" ] && grep -EIlq -e "$CLOUD_SECRET_RE" "$f" 2>/dev/null && printf '%s\n' "$f"
    done ) || true
}

# Install a downloaded archive into a profile directory. Extract to staging,
# validate, sanitize untrusted settings, back up an existing profile, then
# install only the kept files (dropping state and, by default, account
# material) so shared-state symlinks and the identity link are never touched.
cloud_install_archive() {
  local archive="$1" dir="$2" keep_secrets="${3:-0}" staging names re keep backup stamp rc
  staging="$(mktemp -d)"; cloud_track "$staging"
  if ! tar -xzf "$archive" -C "$staging" 2>/dev/null; then
    rm -rf "$staging"
    die "cloud: server did not return a valid archive"
  fi

  # Untrusted archive: neutralize code-execution / wrong-account vectors in
  # settings.json unless the caller opted into a trusted restore.
  if [ "$keep_secrets" != "1" ] && [ -f "$staging/claude/settings.json" ]; then
    if grep -Eq '"(hooks|apiKeyHelper)"' "$staging/claude/settings.json" 2>/dev/null; then
      rc=0; json_del_keys "$staging/claude/settings.json" hooks apiKeyHelper || rc=$?
      [ "$rc" = "0" ] || warn "pulled claude/settings.json defines hooks/apiKeyHelper and no jq/python3 is available to strip them; review it before activating '${dir##*/}'"
    fi
  fi

  names="$CLOUD_STATE_NAMES"
  [ "$keep_secrets" = "1" ] || names="$names $CLOUD_SECRET_NAMES"
  re="$(cloud_name_re "$names")"
  keep="$( ( cd "$staging" && find . -type f | grep -Ev "$re" | grep -Ev "$CLOUD_PLUGIN_ARTIFACT_RE" \
    | grep -Ev "$CLOUD_LEFTOVER_RE" ) || true )"

  if [ -d "$dir" ]; then
    stamp="$(date +%Y%m%d%H%M%S 2>/dev/null || printf 'backup')"
    backup="$BACKUP_DIR/${dir##*/}-prepull-$stamp"
    mkdir -p "$BACKUP_DIR"
    cp -R "$dir" "$backup" || { rm -rf "$staging"; die "cloud: could not back up '${dir##*/}' before overwriting"; }
    printf "Backed up the existing profile to %s\n" "$backup" >&2
  fi

  mkdir -p "$dir"
  if [ -n "$keep" ]; then
    if ! printf '%s\n' "$keep" | (cd "$staging" && tar -cf - -T -) | (cd "$dir" && tar -xf -); then
      rm -rf "$staging"
      die "cloud: could not install the pulled files"
    fi
  fi
  [ -f "$dir/$LAYOUT_FILE" ] || printf '%s\n' "$LAYOUT_VERSION" > "$dir/$LAYOUT_FILE"
  rm -rf "$staging"
}

# Reinstall external plugins referenced by a pulled profile: marketplaces from
# plugins/known_marketplaces.json, enabled plugins from settings.json. This
# restores exactly what CLOUD_PLUGIN_ARTIFACT_RE withheld from the sync; the
# plugin code itself still only runs after 'agman use' under Claude Code's own
# marketplace trust flow. CLAUDE_CONFIG_DIR pins the installs to the pulled
# tree so the active profile is never touched; stdin is closed so an
# interactive claude cannot hang or eat the read loop's input. Best effort —
# failures warn, never die. AGMAN_CLOUD_NO_INSTALL=1 skips entirely.
cloud_install_plugins() {
  local dir="$1" config_dir marketplaces settings repo plugin
  [ "${AGMAN_CLOUD_NO_INSTALL:-}" = "1" ] && return 0
  config_dir="$dir/claude"
  [ -d "$config_dir" ] || return 0
  if ! command -v claude >/dev/null 2>&1; then
    warn "claude CLI not found; pulled plugin references were kept but nothing was reinstalled"
    return 0
  fi
  marketplaces="$config_dir/plugins/known_marketplaces.json"
  if [ -f "$marketplaces" ]; then
    tr ',{}' '\n\n\n' < "$marketplaces" \
      | sed -n 's/.*"repo"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      | sort -u | while IFS= read -r repo; do
        [ -n "$repo" ] || continue
        printf "  adding plugin marketplace %s\n" "$repo"
        CLAUDE_CONFIG_DIR="$config_dir" claude plugin marketplace add "$repo" </dev/null >/dev/null 2>&1 \
          || warn "could not add plugin marketplace $repo"
      done
  fi
  settings="$config_dir/settings.json"
  if [ -f "$settings" ]; then
    # "name@marketplace": true keys, scoped to the enabledPlugins block (the
    # scope degrades to the whole line on single-line JSON — best effort).
    sed -n '/"enabledPlugins"/,/}/p' "$settings" \
      | tr ',{}' '\n\n\n' \
      | sed -n 's/.*"\([^"]*@[^"]*\)"[[:space:]]*:[[:space:]]*true.*/\1/p' \
      | sort -u | while IFS= read -r plugin; do
        [ -n "$plugin" ] || continue
        printf "  installing plugin %s\n" "$plugin"
        CLAUDE_CONFIG_DIR="$config_dir" claude plugin install "$plugin" </dev/null >/dev/null 2>&1 \
          || warn "could not install plugin $plugin"
      done
  fi
}

cloud_login() {
  cloud_require_curl
  local url="" key="" key_stdin=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --url) shift; url="${1:-}"; [ -n "$url" ] || usage_die "--url needs a value" ;;
      --key-stdin) key_stdin=1 ;;
      *) usage_die "unknown option '$1' for cloud login" ;;
    esac
    shift
  done
  if [ -z "$url" ]; then
    printf 'Cloud URL [%s]: ' "$CLOUD_DEFAULT_URL"
    IFS= read -r url || true
    [ -n "$url" ] || url="$CLOUD_DEFAULT_URL"
  fi
  url="${url%/}"
  case "$url" in
    https://*) ;;
    http://*)
      [ "${AGMAN_CLOUD_INSECURE:-0}" = "1" ] || \
        die "refusing a plain http:// URL: your API key and profiles would cross the network in cleartext. Use https://, or set AGMAN_CLOUD_INSECURE=1 to override" ;;
    *) die "cloud URL must start with https://" ;;
  esac
  if [ "$key_stdin" = "1" ]; then
    IFS= read -r key || true
  else
    printf 'API key (Dashboard -> API keys): '
    if command -v stty >/dev/null 2>&1 && [ -t 0 ]; then
      stty -echo; IFS= read -r key || true; stty echo; printf '\n'
    else
      IFS= read -r key || true
    fi
  fi
  [ -n "$key" ] || die "no API key provided"

  cloud_url="$url"; cloud_key="$key"
  local resp code msg
  resp="$(mktemp)"; cloud_track "$resp"
  code="$(cloud_http GET "/api/profiles" "$resp")"
  msg="$(cloud_error_from "$resp")"
  [ "$code" = "200" ] || cloud_die_http "$code" "$msg"

  mkdir -p "$AGMAN_HOME"
  # Create at mode 600 so the key is never briefly world-readable (matches the
  # per-profile token writer).
  ( umask 077; printf 'url=%s\nkey=%s\n' "$url" "$key" > "$CLOUD_FILE" )
  chmod 600 "$CLOUD_FILE"
  printf "Logged in to %s.\nCredentials stored at %s (mode 600, never synced).\n" "$url" "$CLOUD_FILE"
}

cloud_logout() {
  if [ ! -f "$CLOUD_FILE" ]; then
    printf 'Not logged in to agman cloud.\n'
    return 0
  fi
  rm -f "$CLOUD_FILE"
  printf 'Logged out. The API key itself stays valid; revoke it from the dashboard.\n'
}

cloud_status() {
  if [ ! -f "$CLOUD_FILE" ]; then
    printf 'Not logged in to agman cloud. Run: agman cloud login\n'
    return 0
  fi
  cloud_load
  printf 'agman cloud: %s\n' "$cloud_url"
  printf '  credentials: %s (mode 600)\n' "$CLOUD_FILE"
  cloud_require_curl
  local resp code
  resp="$(mktemp)"; cloud_track "$resp"
  code="$(cloud_http GET "/api/profiles" "$resp")"
  case "$code" in
    200) printf '  connection:  ok\n' ;;
    000) printf '  connection:  unreachable\n' ;;
    401) printf '  connection:  key rejected (run agman cloud login again)\n' ;;
    *)   printf '  connection:  HTTP %s\n' "$code" ;;
  esac
}

cloud_list() {
  cloud_load
  cloud_require_curl
  local resp code msg out
  resp="$(mktemp)"; cloud_track "$resp"
  code="$(cloud_http GET "/api/profiles" "$resp")"
  if [ "$code" != "200" ]; then
    msg="$(cloud_error_from "$resp")"
    cloud_die_http "$code" "$msg"
  fi
  # Prefer a real JSON parser so key order and nested objects don't fool us;
  # fall back to a best-effort scan when neither jq nor python3 is present.
  case "$(json_tool)" in
    jq)      out="$(jq -r '.profiles[]? | "  \(.name) (v\(.latestVersion))"' "$resp" 2>/dev/null)" ;;
    python3) out="$(RESP="$resp" python3 -c '
import json, os
try:
    d = json.load(open(os.environ["RESP"]))
    for p in d.get("profiles", []):
        print("  %s (v%s)" % (p.get("name"), p.get("latestVersion")))
except Exception:
    pass' 2>/dev/null)" ;;
    *)       out="$(tr '{' '\n' < "$resp" |
               sed -n 's/.*"name":"\([^"]*\)".*"latestVersion":\([0-9][0-9]*\).*/  \1 (v\2)/p')" ;;
  esac
  if [ -n "$out" ]; then
    printf 'Cloud profiles on %s:\n%s\n' "$cloud_url" "$out"
  else
    printf 'No cloud profiles yet. Push one with: agman cloud push <name>\n'
  fi
}

cloud_push() {
  local name="" include_secrets=0 force=0 dry_run=0 arg
  for arg in ${1+"$@"}; do
    case "$arg" in
      --include-secrets) include_secrets=1 ;;
      --force) force=1 ;;
      --dry-run) dry_run=1 ;;
      -*) usage_die "unknown option '$arg' for cloud push" ;;
      *)
        [ -z "$name" ] || usage_die "cloud push takes at most one profile name"
        name="$arg" ;;
    esac
  done
  if [ -z "$name" ]; then
    name="$(active_profile 2>/dev/null || true)"
    [ -n "$name" ] || usage_die "no active profile; run 'agman cloud push <name>'"
  fi
  require_profile "$name"

  local dir files hits body resp code msg version size max
  dir="$(profile_dir "$name")"
  files="$(cloud_push_files "$dir" "$include_secrets")"
  [ -n "$files" ] || die "profile '$name' has no syncable files to push"
  max="${AGMAN_CLOUD_MAX_PUSH_BYTES:-$CLOUD_MAX_PUSH_BYTES_DEFAULT}"

  # Nothing leaves the machine on a dry run, so no login is needed either.
  if [ "$dry_run" = "1" ]; then
    local sizes total=0 count=0 sz _rest
    sizes="$(mktemp)"; cloud_track "$sizes"
    cloud_sized_listing "$dir" "$files" > "$sizes"
    while read -r sz _rest; do
      total=$((total + sz)); count=$((count + 1))
    done < "$sizes"
    printf "Would push profile '%s': %s file(s), %s bytes (%s MB) uncompressed. Server limit: %s bytes (%s MB) compressed.\n" \
      "$name" "$count" "$total" "$(cloud_mb "$total")" "$max" "$(cloud_mb "$max")"
    sed 's/^/  /' "$sizes"
    return 0
  fi

  cloud_load
  cloud_require_curl

  # A deployment's platform may cap payloads below the app's own limit
  # (Vercel functions cut off just under 4.5 MB), so ask the server what it
  # actually accepts: maxPushBytes is the direct-PUT ceiling, blobPushBytes
  # (when the server offers presigned blob uploads) the overall one. Explicit
  # AGMAN_CLOUD_MAX_PUSH_BYTES always wins and forces the direct path; an
  # older server that advertises nothing keeps the default.
  local advertised blob_max="" direct
  if [ -z "${AGMAN_CLOUD_MAX_PUSH_BYTES:-}" ]; then
    resp="$(mktemp)"; cloud_track "$resp"
    if [ "$(cloud_http GET "/api/profiles" "$resp")" = "200" ]; then
      advertised="$(sed -n 's/.*"maxPushBytes":[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$resp" | head -1)"
      if [ -n "$advertised" ]; then
        max="$advertised"
        cloud_log "server max direct push size: $advertised bytes"
      fi
      blob_max="$(sed -n 's/.*"blobPushBytes":[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$resp" | head -1)"
    fi
  fi
  direct="$max"
  if [ -n "$blob_max" ] && [ "$blob_max" -gt "$direct" ]; then
    max="$blob_max"
    cloud_log "server blob push size: $max bytes"
  fi

  if [ "$include_secrets" = "1" ]; then
    warn "including account material in this push (--include-secrets):"
    printf '%s\n' "$files" | grep -E "$(cloud_name_re "$CLOUD_SECRET_NAMES")" | sed 's/^/    /' >&2 || true
    warn "the server operator can read these, and anyone who pulls with --with-secrets receives them"
  elif [ "$force" != "1" ]; then
    # A blocklist can't see a token pasted into settings.json; scan content too.
    hits="$(cloud_scan_content "$dir" "$files")"
    if [ -n "$hits" ]; then
      printf 'agman: refusing to push: these files look like they contain secrets:\n' >&2
      printf '%s\n' "$hits" | sed 's/^/    /' >&2
      die "remove the secrets, or rerun with --force to push anyway (--include-secrets to also carry credential files)"
    fi
  fi

  body="$(mktemp)"; cloud_track "$body"; resp="$(mktemp)"; cloud_track "$resp"
  if ! printf '%s\n' "$files" | (cd "$dir" && COPYFILE_DISABLE=1 tar -czf - -T -) > "$body"; then
    die "could not archive profile '$name'"
  fi
  [ -s "$body" ] || die "profile '$name' produced an empty archive"
  size="$(wc -c < "$body" | tr -d ' ')"
  cloud_log "archive: $(printf '%s\n' "$files" | grep -c .) file(s), $size bytes"

  # The server would reject an oversized payload anyway; refusing before the
  # PUT and naming the heaviest files makes the fix obvious.
  if [ "$size" -gt "$max" ]; then
    printf "agman: refusing to push '%s': the compressed payload is %s bytes (%s MB), over the server limit of %s bytes (%s MB). Largest files:\n" \
      "$name" "$size" "$(cloud_mb "$size")" "$max" "$(cloud_mb "$max")" >&2
    cloud_sized_listing "$dir" "$files" | head -10 | sed 's/^/    /' >&2
    die "trim the profile ('agman cloud push $name --dry-run' lists everything a push would carry), or set AGMAN_CLOUD_MAX_PUSH_BYTES if your server accepts more"
  fi

  # Interactive pushes get a heads-up plus curl's transfer bar; scripts and
  # captured output see neither (cloud_progress_enabled checks stderr).
  local pflag=""
  if cloud_progress_enabled; then
    pflag=1
    printf "Uploading '%s' (%s MB)...\n" "$name" "$(cloud_mb "$size")" >&2
  fi

  if [ "$size" -gt "$direct" ]; then
    # Too big for a function body: presigned blob upload, then commit. The
    # bytes go straight to blob storage; only small control requests touch
    # the server.
    local upresp upurl uppath upcode
    cloud_log "archive exceeds the direct limit ($direct bytes); using blob upload"
    upresp="$(mktemp)"; cloud_track "$upresp"
    # The server only grants blob uploads for payloads a direct push cannot
    # carry, and caps the presigned URL at the declared size.
    code="$(cloud_http POST "/api/profiles/$name/archive/upload" "$upresp" \
      -H 'Content-Type: application/json' --data-binary "{\"size\":$size}")"
    [ "$code" = "200" ] || cloud_die_http "$code" "$(cloud_error_from "$upresp")"
    upurl="$(sed -n 's/.*"uploadUrl":"\([^"]*\)".*/\1/p' "$upresp" | head -1)"
    uppath="$(sed -n 's/.*"pathname":"\([^"]*\)".*/\1/p' "$upresp" | head -1)"
    if [ -z "$upurl" ] || [ -z "$uppath" ]; then
      die "cloud: the server's upload endpoint returned no upload URL"
    fi
    # The presigned URL is a foreign host: plain curl, the API key stays home.
    if [ -n "$pflag" ]; then
      upcode="$(curl --progress-bar -X PUT --connect-timeout 10 -o /dev/null -w '%{http_code}' \
        -H 'Content-Type: application/gzip' --data-binary "@$body" "$upurl")" || true
    else
      upcode="$(curl -sS -X PUT --connect-timeout 10 -o /dev/null -w '%{http_code}' \
        -H 'Content-Type: application/gzip' --data-binary "@$body" "$upurl" 2>/dev/null)" || true
    fi
    cloud_log "blob PUT: HTTP ${upcode:-000}"
    case "$upcode" in
      2*) ;;
      *) die "cloud: uploading the archive to blob storage failed (HTTP ${upcode:-000})" ;;
    esac
    code="$(cloud_http POST "/api/profiles/$name/archive/commit" "$resp" \
      -H 'Content-Type: application/json' --data-binary "{\"pathname\":\"$uppath\"}")"
  else
    code="$(cloud_http ${pflag:+--progress} PUT "/api/profiles/$name/archive" "$resp" \
      -H 'Content-Type: application/gzip' --data-binary "@$body")"
  fi
  if [ "$code" != "201" ] && [ "$code" != "200" ]; then
    msg="$(cloud_error_from "$resp")"
    cloud_die_http "$code" "$msg"
  fi
  version="$(sed -n 's/.*"version":[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$resp" | head -1)"
  local warnings
  warnings="$(sed -n 's/.*"warnings":[[:space:]]*\(\[[^]]*\]\).*/\1/p' "$resp" | head -1)"
  case "$warnings" in
    ""|"[]") ;;
    *) warn "the server flagged possible secrets in this push: $warnings" ;;
  esac
  if grep -q '"unchanged":[[:space:]]*true' "$resp" 2>/dev/null; then
    # The server deduplicated identical content — no new version was minted.
    printf "Profile '%s' is already up to date (version %s); nothing pushed.\n" "$name" "${version:-?}"
    return 0
  fi
  printf "Pushed profile '%s' (version %s).\n" "$name" "${version:-?}"
  local omitted
  omitted="$(sed -n 's/.*"omitted":[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$resp" | head -1)"
  case "$omitted" in
    ""|0) ;;
    *) printf "  %s reinstallable plugin file(s) omitted server-side; pull reinstalls them.\n" "$omitted" ;;
  esac
}

cloud_pull() {
  local name="" local_name="" force=0 keep_secrets=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --as) shift; local_name="${1:-}"; [ -n "$local_name" ] || usage_die "--as needs a profile name" ;;
      --force) force=1 ;;
      --with-secrets) keep_secrets=1 ;;
      -*) usage_die "unknown option '$1' for cloud pull" ;;
      *)
        [ -z "$name" ] || usage_die "cloud pull takes one profile name"
        name="$1" ;;
    esac
    shift
  done
  [ -n "$name" ] || usage_die "usage: agman cloud pull <name> [--as <local-name>] [--force] [--with-secrets]"
  local_name="${local_name:-$name}"
  validate_name "$name"
  validate_name "$local_name"
  # Names are compared case-insensitively because macOS/Windows/Git Bash map
  # 'Work' and 'work' to one directory: a case-only alias must not slip past
  # the reserved-name or active-profile guards.
  case "$(cloud_lc "$local_name")" in
    global) die "'global' is the backup of your original config; pull into another name" ;;
  esac
  cloud_load
  cloud_require_curl

  local dir existed=1 current_active=""
  dir="$(profile_dir "$local_name")"
  current_active="$(active_profile 2>/dev/null || true)"
  if [ -n "$current_active" ] && [ "$(cloud_lc "$current_active")" = "$(cloud_lc "$local_name")" ] && [ "$force" != "1" ]; then
    die "profile '$local_name' is active; a pull would rewrite live tool config (rerun with --force)"
  fi
  if [ ! -d "$dir" ]; then
    require_creatable_name "$local_name"
    existed=0
  fi

  local resp code msg
  resp="$(mktemp)"; cloud_track "$resp"
  code="$(cloud_http GET "/api/profiles/$name/archive" "$resp")"
  if [ "$code" != "200" ]; then
    msg="$(cloud_error_from "$resp")"
    cloud_die_http "$code" "$msg"
  fi
  cloud_install_archive "$resp" "$dir" "$keep_secrets"
  cloud_install_plugins "$dir"
  printf "Pulled cloud profile '%s' into '%s'.\n" "$name" "$local_name"
  [ "$existed" = "1" ] || printf "Activate it with: agman use %s\n" "$local_name"
}

cloud_init() {
  local org="" name="" keep_secrets=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --with-secrets) keep_secrets=1 ;;
      -*) usage_die "unknown option '$1' for cloud init" ;;
      *)
        if [ -z "$org" ]; then org="$1"
        elif [ -z "$name" ]; then name="$1"
        else usage_die "cloud init takes an org slug and an optional profile name"; fi ;;
    esac
    shift
  done
  [ -n "$org" ] || usage_die "usage: agman cloud init <org-slug> [profile-name] [--with-secrets]"
  validate_name "$org"
  name="${name:-$org}"
  require_creatable_name "$name"
  if [ -d "$(profile_dir "$name")" ]; then
    die "profile '$name' already exists (use 'agman cloud pull' to update it)"
  fi
  cloud_load
  cloud_require_curl

  local resp code msg
  resp="$(mktemp)"; cloud_track "$resp"
  code="$(cloud_http GET "/api/orgs/$org/default-profile/archive" "$resp")"
  if [ "$code" != "200" ]; then
    msg="$(cloud_error_from "$resp")"
    cloud_die_http "$code" "$msg"
  fi
  cloud_install_archive "$resp" "$(profile_dir "$name")" "$keep_secrets"
  cloud_install_plugins "$(profile_dir "$name")"
  printf "Created profile '%s' from team '%s'.\nActivate it with: agman use %s\n" "$name" "$org" "$name"
}

cmd_cloud() {
  trap cloud_cleanup EXIT INT TERM
  case "${1:-}" in
    -v|--verbose) AGMAN_VERBOSE=1; shift ;;
  esac
  local sub="${1:-status}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    login)   cloud_login ${1+"$@"} ;;
    logout)  cloud_logout ;;
    status)  cloud_status ;;
    list|ls) cloud_list ;;
    push)    cloud_push ${1+"$@"} ;;
    pull)    cloud_pull ${1+"$@"} ;;
    init)    cloud_init ${1+"$@"} ;;
    *) usage_die "unknown cloud subcommand '$sub' (login|logout|status|list|push|pull|init)" ;;
  esac
}

# ---------------------------------------------------------------------------
# stealth
#
# `agman stealth` blocks a company-injected OTEL exporter at the network layer,
# so telemetry never leaves this machine even when the endpoint is forced by
# team-managed settings (an env var you cannot switch off). A local mitmproxy
# daemon intercepts requests and answers the exporter's host with 403; Claude
# Code is launched with HTTPS_PROXY/HTTP_PROXY pointed at it, so every other
# request (api.anthropic.com and friends) still works. Requires mitmproxy
# (mitmdump), lsof, and curl — like `cloud` needs curl/tar, checked only when
# this command runs.
#
# The blocker is a generated mitmproxy addon. mitmproxy's scripting interface
# is Python-only, so `stealth` writes a small `.py` addon at runtime and runs
# mitmdump with it; the driver itself stays pure bash. Machine-local state lives
# under $AGMAN_HOME/.stealth (a sibling of profiles, so never synced or cloned).

STEALTH_DIR="$AGMAN_HOME/.stealth"
STEALTH_CA="${AGMAN_STEALTH_CA:-$HOME/.mitmproxy/mitmproxy-ca-cert.pem}"
STEALTH_PID_FILE="$STEALTH_DIR/mitmdump.pid"
STEALTH_HOST_FILE="$STEALTH_DIR/blocked_host"
# Records the --allow-hosts regex the running daemon was started with. A daemon
# predating the 0.17.2 passthrough fix has no such file, so stewardship can tell
# a MITM-everything daemon apart from a passthrough one and restart stale ones.
STEALTH_ALLOW_FILE="$STEALTH_DIR/allow_hosts"
STEALTH_ADDON_FILE="$STEALTH_DIR/block_otel.py"
# Records which addon generation the running daemon was started with. The addon
# blocks OTLP paths rather than whole hosts (a blocked host may also serve
# traffic claude needs), so a daemon still running an older addon is restarted
# even when its host list matches.
STEALTH_ADDONVER_FILE="$STEALTH_DIR/addon_version"
STEALTH_ADDONVER="2"
STEALTH_LOG_FILE="$STEALTH_DIR/mitmdump.log"
STEALTH_PORT="${AGMAN_STEALTH_PORT:-8080}"
STEALTH_PROFILES_DIR="$STEALTH_DIR/profiles"
STEALTH_OTEL_VARS="OTEL_EXPORTER_OTLP_ENDPOINT OTEL_EXPORTER_OTLP_TRACES_ENDPOINT OTEL_EXPORTER_OTLP_METRICS_ENDPOINT OTEL_EXPORTER_OTLP_LOGS_ENDPOINT"
# Claude Code's admin-managed settings (macOS, Linux/WSL, Windows via Git Bash),
# colon-separated. Overridable so tests never read the real machine's policy.
STEALTH_MANAGED_FILES="${AGMAN_STEALTH_MANAGED:-/Library/Application Support/ClaudeCode/managed-settings.json:/etc/claude-code/managed-settings.json:/c/Program Files/ClaudeCode/managed-settings.json}"

# The OTLP request paths an exporter sends to the endpoint: the HTTP/json and
# HTTP/protobuf exporters append /v1/traces, /v1/metrics or /v1/logs; the gRPC
# exporter posts to the service paths. Blocking only these paths is what lets
# a host that also serves other traffic keep working.
STEALTH_OTLP_HTTP_PATHS="v1/traces v1/metrics v1/logs"
STEALTH_OTLP_GRPC_PREFIXES="opentelemetry.proto.collector.trace.v1.TraceService/ opentelemetry.proto.collector.metrics.v1.MetricsService/ opentelemetry.proto.collector.logs.v1.LogsService/"

# Bare hostname out of an OTLP endpoint URL: strip scheme, userinfo, port,
# path, query, and fragment. bash 3.2 has no ${var,,}, so lowercase via tr.
stealth_host_of_url() {
  local host="${1:-}"
  case "$host" in
    *://*) host="${host#*://}" ;;
  esac
  host="${host%%/*}"; host="${host##*@}"; host="${host%%:*}"; host="${host%%.}"
  printf '%s' "$host" | tr '[:upper:]' '[:lower:]'
}

# "host" or "host/base-path" out of one endpoint URL. The path is kept so the
# block can stay scoped to the exporter's own paths: a telemetry host may
# share its name with traffic claude needs (a company gateway serves login,
# managed settings and OTEL on one hostname). A URL that already ends in an
# OTLP path (.../v1/traces) names one signal's route, and a collector serves
# the other signals beside it — so the parent path is kept and all of the
# exporter's paths under it are blocked. Query strings and fragments are
# dropped; the path is not percent-decoded (exporter endpoints do not use
# escapes).
stealth_target_of_url() {
  local item="$1" host rest path="" s suf
  host="$(stealth_host_of_url "$item")"
  [ -n "$host" ] || return 0
  rest="$item"
  case "$rest" in *://*) rest="${rest#*://}" ;; esac
  case "$rest" in
    *[/?#]*)
      path="${rest#*[/?#]}"
      path="${path%%[?#]*}"
      path="${path%/}"
      ;;
  esac
  if [ -n "$path" ]; then
    for s in $STEALTH_OTLP_HTTP_PATHS; do
      case "$path" in
        "$s") path="" ;;
        *)
          suf="/$s"
          case "$path" in *"$suf") path="${path%"$suf"}" ;; esac ;;
      esac
    done
    path="${path#/}"
  fi
  if [ -n "$path" ]; then printf '%s/%s\n' "$host" "$path"
  else printf '%s\n' "$host"; fi
}

# Comma-separated OTLP endpoints -> newline-separated, sorted, de-duplicated
# targets ("host" or "host/base-path").
stealth_targets_of_urls() {
  local list="${1:-}" item
  list="${list},"
  while [ -n "$list" ]; do
    item="${list%%,*}"
    list="${list#*,}"
    item="$(printf '%s' "$item" | tr -d '[:space:]')"
    [ -n "$item" ] || continue
    stealth_target_of_url "$item"
  done | sort -u
}

# newline-separated hosts -> comma-separated, for display.
stealth_hosts_commas() { printf '%s' "$1" | tr '\n' ',' | sed 's/,$//; s/,/, /g'; }

# newline-separated targets -> a Python dict literal mapping each host to the
# exporter's request paths blocked on it: the OTLP paths under its base path.
stealth_targets_pydict() {
  local t host base s p paths out="{"
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    host="${t%%/*}"
    case "$t" in */*) base="${t#*/}" ;; *) base="" ;; esac
    paths=""
    for s in $STEALTH_OTLP_HTTP_PATHS; do
      p="/${base:+$base/}$s"
      paths="${paths:+$paths, }\"$p\""
    done
    for s in $STEALTH_OTLP_GRPC_PREFIXES; do
      p="/${base:+$base/}$s"
      paths="${paths:+$paths, }\"$p\""
    done
    out="$out\"$host\": [$paths], "
  done <<EOF
$1
EOF
  printf '%s}' "${out%, }"
}

# newline-separated hosts -> a single --allow-hosts regex (alternation).
stealth_hosts_regex() {
  local hosts="$1" h esc alt=""
  while IFS= read -r h; do
    [ -n "$h" ] || continue
    esc="$(printf '%s' "$h" | sed 's/\./\\./g')"
    alt="${alt:+$alt|}$esc"
  done <<EOF
$hosts
EOF
  printf '^(.*\.)?(%s)(:[0-9]+)?$' "$alt"
}

stealth_require_deps() {
  command -v mitmdump >/dev/null 2>&1 || die "mitmdump (mitmproxy) is required for stealth (brew install mitmproxy)"
  command -v lsof     >/dev/null 2>&1 || die "lsof is required for stealth"
  command -v curl     >/dev/null 2>&1 || die "curl is required for stealth"
}

# --- per-profile stealth config ---------------------------------------------
#
# Saved hosts and the enabled flag are machine-local, like the daemon: they
# live under $STEALTH_DIR/profiles, not inside the profile tree, so a cloud
# push or a `create --from` clone never turns stealth on somewhere mitmproxy
# isn't installed. rename/remove keep them in step with the profile.

stealth_profile_file() { printf '%s/%s.%s' "$STEALTH_PROFILES_DIR" "$1" "$2"; }

stealth_saved_hosts() {
  local f; f="$(stealth_profile_file "$1" hosts)"
  [ -f "$f" ] && sed '/^$/d' "$f"
  return 0
}

stealth_write_hosts() {
  local name="$1" hosts="$2" f
  f="$(stealth_profile_file "$name" hosts)"
  if [ -z "$hosts" ]; then rm -f "$f"; return 0; fi
  mkdir -p "$STEALTH_PROFILES_DIR"
  printf '%s\n' "$hosts" | sed '/^$/d' | sort -u > "$f"
}

stealth_is_enabled() { [ -f "$(stealth_profile_file "$1" enabled)" ]; }

stealth_forget_profile() {
  rm -f "$(stealth_profile_file "$1" hosts)" "$(stealth_profile_file "$1" enabled)"
}

stealth_rename_profile() {
  local old="$1" new="$2" ext
  for ext in hosts enabled; do
    [ -f "$(stealth_profile_file "$old" "$ext")" ] || continue
    mv "$(stealth_profile_file "$old" "$ext")" "$(stealth_profile_file "$new" "$ext")"
  done
}

# The profile a bare `claude` would run with here: the one CLAUDE_CONFIG_DIR
# points into (a per-shell override always wins), else the active profile.
stealth_current_profile() {
  local name
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    profile_name_from_target "$CLAUDE_CONFIG_DIR" && return 0
    return 1
  fi
  name="$(active_profile 2>/dev/null || default_profile 2>/dev/null)" || return 1
  [ -n "$name" ] && printf '%s' "$name"
}

# --- auto-detection -----------------------------------------------------------
#
# Claude Code reads the exporter endpoint from the environment, which settings
# files can inject through their "env" block: user settings, project settings
# in the current directory, and the admin-managed file. Scanning for the
# OTEL_EXPORTER_OTLP_*ENDPOINT keys is a plain grep — no JSON parser needed.
# Loopback collectors are skipped: NO_PROXY bypasses the proxy for them, and
# they don't send anything off the machine.

stealth_is_loopback() {
  case "$1" in
    localhost|*.localhost|127.*|0.0.0.0|::1|\[*) return 0 ;;
  esac
  return 1
}

# "host-or-target<TAB>source" lines for one endpoint value.
stealth_detect_emit() {
  local val="$1" src="$2" t h
  stealth_targets_of_urls "$val" | while IFS= read -r t; do
    [ -n "$t" ] || continue
    h="${t%%/*}"
    stealth_is_loopback "$h" && continue
    printf '%s\t%s\n' "$t" "$src"
  done
}

# All OTEL endpoints Claude would see with the given config dir, as
# "host<TAB>source" lines.
stealth_detect() {
  local claude_dir="${1:-}" var val f list
  [ -n "$claude_dir" ] || claude_dir="${CLAUDE_CONFIG_DIR:-$TARGET_HOME/.claude}"
  for var in $STEALTH_OTEL_VARS; do
    eval "val=\${$var:-}"
    [ -n "$val" ] && stealth_detect_emit "$val" "\$$var"
  done
  # Colon-separated so paths with spaces (macOS's managed dir) survive.
  list="$claude_dir/settings.json:$claude_dir/settings.local.json:$PWD/.claude/settings.json:$PWD/.claude/settings.local.json:$STEALTH_MANAGED_FILES:"
  while [ -n "$list" ]; do
    f="${list%%:*}"; list="${list#*:}"
    [ -n "$f" ] && [ -f "$f" ] || continue
    grep -o '"OTEL_EXPORTER_OTLP_[A-Z_]*ENDPOINT"[[:space:]]*:[[:space:]]*"[^"]*"' "$f" 2>/dev/null \
      | sed 's/^"[A-Z_]*"[[:space:]]*:[[:space:]]*"//; s/"$//' \
      | while IFS= read -r val; do stealth_detect_emit "$val" "$f"; done
  done
  return 0
}

# Resolve the profile a stealth subcommand acts on: --profile wins, else the
# current one. Dies with a hint when neither exists.
stealth_target_profile() {
  local name="${1:-}"
  if [ -z "$name" ]; then
    name="$(stealth_current_profile || true)"
    [ -n "$name" ] || die "no active profile; pass --profile <name>"
  fi
  require_profile "$name"
  printf '%s' "$name"
}

# PID from the tracked daemon pid file, or empty.
stealth_daemon_pid() {
  [ -f "$STEALTH_PID_FILE" ] || return 1
  local pid
  pid="$(<"$STEALTH_PID_FILE")"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  printf '%s\n' "$pid"
}

# PID listening on the stealth port, or empty. Guarded so stop/status still
# work when lsof is absent.
stealth_port_owner() {
  command -v lsof >/dev/null 2>&1 || return 0
  local out
  out="$(lsof -iTCP:"$STEALTH_PORT" -sTCP:LISTEN -F p 2>/dev/null || true)"
  [ -z "$out" ] && return 0
  printf '%s\n' "$out" | sed -n 's/^p//p' | head -1
}

stealth_is_mitmdump() {
  local pid="${1:-}"
  [ -n "$pid" ] || return 1
  ps -p "$pid" -o comm= 2>/dev/null | grep -q 'mitmdump'
}

stealth_stop_daemon() {
  local pid i lp
  pid="$(stealth_daemon_pid || true)"
  if [ -n "$pid" ]; then
    printf 'Stopping stealth daemon (pid %s)...\n' "$pid"
    kill "$pid" 2>/dev/null || true
    for i in {1..30}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
    printf 'Stopped.\n'
  fi
  lp="$(stealth_port_owner || true)"
  if [ -n "$lp" ] && [ "$lp" != "$pid" ] && stealth_is_mitmdump "$lp"; then
    printf 'Killing untracked mitmdump on port %s (pid %s).\n' "$STEALTH_PORT" "$lp"
    kill "$lp" 2>/dev/null || true
  fi
  rm -f "$STEALTH_PID_FILE" "$STEALTH_HOST_FILE" "$STEALTH_ADDON_FILE" "$STEALTH_ALLOW_FILE" "$STEALTH_ADDONVER_FILE"
}

stealth_start_daemon() {
  local hosts="$1" pid i lp pylist allowre
  mkdir -p "$STEALTH_DIR"
  # Wait out a just-stopped daemon so we don't fail to bind its port.
  for i in {1..30}; do
    lp="$(stealth_port_owner || true)"
    [ -z "$lp" ] && break
    sleep 0.1
  done
  if [ -n "$(stealth_port_owner || true)" ]; then
    die "port $STEALTH_PORT is still in use; free it or set AGMAN_STEALTH_PORT"
  fi
  pydict="$(stealth_targets_pydict "$hosts")"
  cat > "$STEALTH_ADDON_FILE" <<PYEOF
from mitmproxy import http

# Generated by agman stealth. Blocks only the OpenTelemetry exporter's own
# request paths on each listed host; every other request to those hosts is
# passed through to the real server untouched, so a host that also serves
# non-telemetry traffic (a company gateway serving login or managed settings,
# for example) keeps working.

BLOCKED = ${pydict}

def request(flow: http.HTTPFlow) -> None:
    prefixes = None
    for host in BLOCKED:
        if flow.request.pretty_host == host or flow.request.pretty_host.endswith("." + host):
            prefixes = BLOCKED[host]
            break
    if prefixes is None:
        return
    path = flow.request.path.split("?", 1)[0]
    if path.endswith("/") and len(path) > 1:
        path = path[:-1]
    for p in prefixes:
        if path == p or path.startswith(p + "/"):
            flow.response = http.Response.make(
                403,
                b"blocked by agman stealth",
                {"Content-Type": "text/plain"},
            )
            print("[agman stealth] blocked %s %s" % (flow.request.method, flow.request.pretty_url), flush=True)
            return
PYEOF

  # Intercept only the blocked hosts; pass everything else through un-decrypted so
  # tools that don't trust the mitmproxy CA (uv, gh, curl, git, …) see the real
  # server certificate and keep working. Dots are escaped for the regex.
  allowre="$(stealth_hosts_regex "$hosts")"
  printf 'Starting stealth daemon on 127.0.0.1:%s (blocking %s)...\n' \
    "$STEALTH_PORT" "$(stealth_hosts_commas "$hosts")"
  nohup mitmdump --listen-host 127.0.0.1 --listen-port "$STEALTH_PORT" \
    --allow-hosts "$allowre" \
    -s "$STEALTH_ADDON_FILE" \
    >"$STEALTH_LOG_FILE" 2>&1 </dev/null &
  pid=$!
  disown 2>/dev/null || true

  for i in {1..50}; do
    lsof -iTCP:"$STEALTH_PORT" -sTCP:LISTEN >/dev/null 2>&1 && break
    if ! kill -0 "$pid" 2>/dev/null; then
      printf 'agman: mitmdump exited during startup. Log:\n' >&2
      tail -40 "$STEALTH_LOG_FILE" 2>/dev/null || true
      exit 1
    fi
    sleep 0.1
  done
  if ! lsof -iTCP:"$STEALTH_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    printf 'agman: mitmdump failed to bind port %s within 5s. Log:\n' "$STEALTH_PORT" >&2
    tail -40 "$STEALTH_LOG_FILE" 2>/dev/null || true
    exit 1
  fi

  printf '%s\n' "$pid" > "$STEALTH_PID_FILE"
  printf '%s\n' "$hosts" > "$STEALTH_HOST_FILE"
  printf '%s\n' "$allowre" > "$STEALTH_ALLOW_FILE"
  printf '%s\n' "$STEALTH_ADDONVER" > "$STEALTH_ADDONVER_FILE"
  printf 'Stealth daemon started (pid %s). Log: %s\n' "$pid" "$STEALTH_LOG_FILE"
}

stealth_ensure_daemon() {
  local hosts="$1" pid lp current_host allowre current_allowre
  mkdir -p "$STEALTH_DIR"
  pid="$(stealth_daemon_pid || true)"
  if [ -n "$pid" ]; then
    current_host=""
    [ -f "$STEALTH_HOST_FILE" ] && current_host="$(<"$STEALTH_HOST_FILE")"
    # Sessions launched earlier still route through this daemon. Replacing its
    # host list would unblock their hosts mid-session, so it only ever grows;
    # `agman stealth stop` is what resets it.
    hosts="$(printf '%s\n%s\n' "$current_host" "$hosts" | sed '/^$/d' | sort -u)"
    if [ "$current_host" = "$hosts" ]; then
      # Reuse only a daemon started with the passthrough (--allow-hosts); one
      # predating that fix MITMs everything and breaks git/uv/gh on its cert.
      allowre="$(stealth_hosts_regex "$hosts")"
      current_allowre=""
      [ -f "$STEALTH_ALLOW_FILE" ] && current_allowre="$(<"$STEALTH_ALLOW_FILE")"
      if [ "$current_allowre" != "$allowre" ]; then
        printf 'Daemon predates the passthrough fix; restarting.\n'
      elif [ ! -f "$STEALTH_ADDONVER_FILE" ] || [ "$(<"$STEALTH_ADDONVER_FILE")" != "$STEALTH_ADDONVER" ]; then
        printf 'Daemon runs an older block addon; restarting.\n'
      else
        printf 'Reusing stealth daemon (pid %s, port %s).\n' "$pid" "$STEALTH_PORT"
        return 0
      fi
    else
      printf 'Adding blocked hosts; restarting (now: %s).\n' "$(stealth_hosts_commas "$hosts")"
    fi
    stealth_stop_daemon
    stealth_start_daemon "$hosts"
    return 0
  fi
  lp="$(stealth_port_owner || true)"
  if [ -n "$lp" ]; then
    if ! stealth_is_mitmdump "$lp"; then
      die "port $STEALTH_PORT is in use by pid $lp (not mitmdump); free it or set AGMAN_STEALTH_PORT"
    fi
    # An untracked mitmdump on our port blocks hosts we cannot verify, so adopting
    # it could silently leak telemetry. Stop it and start our own.
    printf 'Replacing untracked mitmdump on port %s (pid %s) with our own.\n' "$STEALTH_PORT" "$lp"
    stealth_stop_daemon
  fi
  stealth_start_daemon "$hosts"
}

# Ensure the mitmproxy CA exists (Node trusts it via NODE_EXTRA_CA_CERTS even
# when it is not installed in the system keychain).
stealth_ensure_ca() {
  [ -f "$STEALTH_CA" ] && return 0
  printf 'Generating mitmproxy CA...\n'
  mitmdump --listen-port 18099 -q >/dev/null 2>&1 &
  local gen_pid=$! i
  for i in {1..30}; do
    [ -f "$STEALTH_CA" ] && break
    sleep 0.1
  done
  kill "$gen_pid" 2>/dev/null || true
  wait "$gen_pid" 2>/dev/null || true
  [ -f "$STEALTH_CA" ] || die "failed to generate mitmproxy CA at $STEALTH_CA"
  if [ "$(uname -s)" = "Darwin" ]; then
    if ! security verify-cert -c "$STEALTH_CA" >/dev/null 2>&1; then
      printf 'mitmproxy CA not trusted system-wide; Node will trust it via NODE_EXTRA_CA_CERTS.\n' >&2
      printf 'Optional one-time trust:\n  sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain %s\n' "$STEALTH_CA" >&2
    fi
  fi
}

# Confirm the block fires before launching, with two checks per target:
#   1. an OTLP path must be answered by the addon's own 403 — with path-scoped
#      blocking a wrong rule would pass the exporter through and telemetry
#      would leak, so anything else is a hard stop;
#   2. a non-telemetry path must NOT be answered by the addon — path scoping
#      exists so a shared host keeps serving its other traffic, and an agman
#      403 there means the rule is over-broad.
# An unreachable host (000) is only a warning — nothing can leak when the
# host is down.
stealth_verify_block() {
  local targets="$1" t host base probe url code body tmpf
  tmpf="$(mktemp "${TMPDIR:-/tmp}/agman-block-check.XXXXXX")" || return 1
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    host="${t%%/*}"
    case "$t" in */*) base="/${t#*/}" ;; *) base="" ;; esac
    probe="${base}/v1/traces"

    url="https://${host}${probe}"
    code="$(curl -s -o "$tmpf" -w '%{http_code}' --max-time 6 -k \
      -x "http://127.0.0.1:${STEALTH_PORT}" "$url" 2>/dev/null || true)"
    code="${code:-000}"
    body=""
    [ -f "$tmpf" ] && body="$(cat "$tmpf" 2>/dev/null)"
    if [ "$code" = "403" ] && [ "$body" = "blocked by agman stealth" ]; then
      printf 'Block verified: %s -> 403.\n' "$t"
    elif [ "$code" = "000" ]; then
      printf 'agman: warning: could not verify the block for %s (connection failed).\n' "$t" >&2
    else
      rm -f "$tmpf"
      die "block check for ${t} returned ${code} (expected the agman 403) — telemetry would leak; check ${STEALTH_LOG_FILE}"
    fi

    url="https://${host}/"
    code="$(curl -s -o "$tmpf" -w '%{http_code}' --max-time 6 -k \
      -x "http://127.0.0.1:${STEALTH_PORT}" "$url" 2>/dev/null || true)"
    code="${code:-000}"
    body=""
    [ -f "$tmpf" ] && body="$(cat "$tmpf" 2>/dev/null)"
    if [ "$code" = "403" ] && [ "$body" = "blocked by agman stealth" ]; then
      rm -f "$tmpf"
      die "block check for ${t}: a non-telemetry path (${url}) got the agman 403 — the block is broader than the exporter; check ${STEALTH_LOG_FILE}"
    elif [ "$code" = "000" ]; then
      printf 'agman: warning: could not verify passthrough for %s (connection failed).\n' "$t" >&2
    else
      printf 'Passthrough verified: %s -> %s.\n' "$t" "$code"
    fi
  done <<EOF
$targets
EOF
  rm -f "$tmpf"
}

stealth_claude() {
  local otel="" profile="" arg hosts claude_config="" save=0 pname="" given saved detected h src memargs=""
  local claude_args n=0
  claude_args=()
  # --otel/--profile belong to stealth; every other argument (positionals and
  # claude flags like --resume, --continue, -p) is forwarded to claude as-is,
  # in order, whether or not a `--` separator is present.
  # --otel repeats and accepts --otel=<list>. An unquoted "a.com, b.com" reaches
  # us as two words; a word ending in (or the next starting with) a comma
  # continues the list, so b.com is blocked instead of becoming a claude prompt.
  local val
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --otel|--otel=*)
        if [ "$arg" = "--otel" ]; then
          [ $# -gt 0 ] || usage_die "--otel requires a value"
          val="$1"; shift
        else
          val="${arg#--otel=}"
        fi
        while [ $# -gt 0 ]; do
          case "$1" in -*) break ;; esac
          case "$val" in
            *,|*", "|*",  ") ;;
            *) case "$1" in ,*) ;; *) break ;; esac ;;
          esac
          val="$val,$1"; shift
        done
        [ -n "$(printf '%s' "$val" | tr -d '[:space:],')" ] || usage_die "--otel requires a value"
        otel="${otel:+$otel,}$val" ;;
      --profile) profile="${1:-}"; [ -n "$profile" ] || usage_die "--profile requires a profile name"; shift ;;
      --save) save=1 ;;
      --) while [ $# -gt 0 ]; do claude_args[$n]="$1"; n=$((n+1)); shift; done ;;
      *) claude_args[$n]="$arg"; n=$((n+1)) ;;
    esac
  done

  if [ -n "$profile" ]; then
    require_profile "$profile"
    pname="$profile"
    claude_config="$(profile_claude_dir "$(profile_dir "$profile")")"
  else
    pname="$(stealth_current_profile || true)"
  fi

  given=""
  if [ -n "$otel" ]; then
    given="$(stealth_targets_of_urls "$otel")"
    [ -n "$given" ] || die "could not parse a host from --otel '$otel'"
  fi
  if [ "$save" = "1" ]; then
    [ -n "$given" ] || usage_die "--save requires --otel <host>"
    [ -n "$pname" ] || die "--save needs a profile; pass --profile <name>"
    stealth_write_hosts "$pname" "$(printf '%s\n%s\n' "$(stealth_saved_hosts "$pname")" "$given")"
    printf "Saved %s for profile '%s'.\n" "$(stealth_hosts_commas "$given")" "$pname"
  fi

  # Block the union of --otel, the profile's saved hosts, and whatever Claude
  # would be configured to export to: blocking an extra host is harmless,
  # missing one leaks.
  saved=""
  [ -n "$pname" ] && saved="$(stealth_saved_hosts "$pname")"
  detected="$(stealth_detect "$claude_config")"
  if [ -n "$detected" ]; then
    printf '%s\n' "$detected" | while IFS="$(printf '\t')" read -r h src; do
      printf 'Detected OTEL endpoint %s (%s).\n' "$h" "$src"
    done
  fi
  hosts="$(printf '%s\n%s\n%s\n' "$given" "$saved" "$(printf '%s\n' "$detected" | cut -f1)" | sed '/^$/d' | sort -u)"
  if [ -z "$hosts" ]; then
    die "stealth claude requires --otel <host>: nothing is saved for ${pname:-this profile} and no OTEL exporter was detected"
  fi

  stealth_require_deps
  command -v claude >/dev/null 2>&1 || die "claude CLI not found on PATH"
  [ -n "$profile" ] && link_profile_identity "$(profile_dir "$profile")"

  stealth_ensure_ca
  stealth_ensure_daemon "$hosts"
  stealth_verify_block "$hosts"

  export HTTPS_PROXY="http://127.0.0.1:${STEALTH_PORT}"
  export HTTP_PROXY="http://127.0.0.1:${STEALTH_PORT}"
  export NO_PROXY="localhost,127.0.0.1,::1"
  export no_proxy="localhost,127.0.0.1,::1"
  export NODE_EXTRA_CA_CERTS="$STEALTH_CA"
  if [ -n "$claude_config" ]; then
    export CLAUDE_CONFIG_DIR="$claude_config"
  fi
  # Whether the other profile came from --profile or the shell's
  # CLAUDE_CONFIG_DIR, keep the machine-active profile's memory out of it.
  if memory_exclude_guard ${claude_args[@]+"${claude_args[@]}"}; then
    memargs="$(memory_exclude_args "${CLAUDE_CONFIG_DIR:-$TARGET_HOME/.claude}")"
    if [ -n "$memargs" ]; then
      claude_args[$n]="$memargs"
      n=$((n + 1))
    fi
  fi
  printf 'Launching claude with OTEL hosts %s blocked.\n' "$(stealth_hosts_commas "$hosts")"
  exec claude ${claude_args[@]+"${claude_args[@]}"}
}

stealth_status() {
  local pid lp hosts f name saved state seen=""
  pid="$(stealth_daemon_pid || true)"
  if [ -n "$pid" ]; then
    hosts="<unknown>"
    [ -f "$STEALTH_HOST_FILE" ] && hosts="$(<"$STEALTH_HOST_FILE")"
    printf 'Stealth daemon running (pid %s, port %s).\n' "$pid" "$STEALTH_PORT"
    printf '  Blocked hosts: %s\n' "$(stealth_hosts_commas "$hosts")"
    printf '  State dir:     %s\n' "$STEALTH_DIR"
  else
    lp="$(stealth_port_owner || true)"
    if [ -n "$lp" ] && stealth_is_mitmdump "$lp"; then
      printf 'Port %s held by untracked mitmdump (pid %s).\n' "$STEALTH_PORT" "$lp"
    elif [ -n "$lp" ]; then
      printf 'Port %s held by pid %s (not mitmdump).\n' "$STEALTH_PORT" "$lp"
    else
      printf 'No stealth daemon running.\n'
    fi
  fi
  for f in "$STEALTH_PROFILES_DIR"/*.hosts "$STEALTH_PROFILES_DIR"/*.enabled; do
    [ -f "$f" ] || continue
    name="${f##*/}"; name="${name%.*}"
    case "$seen/" in */"$name"/*) continue ;; esac
    [ -n "$seen" ] || printf 'Profiles:\n'
    seen="$seen/$name"
    state="off"; stealth_is_enabled "$name" && state="on"
    saved="$(stealth_saved_hosts "$name")"
    printf '  %-14s stealth %-3s  saved hosts: %s\n' "$name" "$state" \
      "$( [ -n "$saved" ] && stealth_hosts_commas "$saved" || printf 'none')"
  done
}

# agman stealth detect [--profile <name>]
stealth_cmd_detect() {
  local profile="" arg dir="" out
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --profile) profile="${1:-}"; [ -n "$profile" ] || usage_die "--profile requires a profile name"; shift ;;
      *) usage_die "unexpected argument '$arg' for stealth detect" ;;
    esac
  done
  if [ -n "$profile" ]; then
    require_profile "$profile"
    dir="$(profile_claude_dir "$(profile_dir "$profile")")"
  fi
  out="$(stealth_detect "$dir")"
  if [ -z "$out" ]; then
    printf 'No OTEL exporter endpoint detected.\n'
    return 0
  fi
  printf '%s\n' "$out" | awk -F '\t' '{ printf "%-30s %s\n", $1, $2 }'
}

# agman stealth hosts [list|add|rm] [<host>…] [--profile <name>]
stealth_cmd_hosts() {
  local action="list" profile="" arg list="" name given saved
  case "${1:-}" in list|add|rm|remove) action="$1"; shift ;; esac
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --profile) profile="${1:-}"; [ -n "$profile" ] || usage_die "--profile requires a profile name"; shift ;;
      -*) usage_die "unknown option '$arg' for stealth hosts" ;;
      *) list="${list:+$list,}$arg" ;;
    esac
  done
  name="$(stealth_target_profile "$profile")"
  saved="$(stealth_saved_hosts "$name")"
  case "$action" in
    list)
      [ -z "$list" ] || usage_die "stealth hosts list takes no hosts (did you mean 'add'?)"
      if [ -n "$saved" ]; then printf '%s\n' "$saved"
      else printf "No hosts saved for '%s'.\n" "$name"; fi ;;
    add)
      given="$(stealth_targets_of_urls "$list")"
      [ -n "$given" ] || usage_die "stealth hosts add requires at least one host"
      stealth_write_hosts "$name" "$(printf '%s\n%s\n' "$saved" "$given")"
      printf "Saved %s for profile '%s'.\n" "$(stealth_hosts_commas "$given")" "$name" ;;
    rm|remove)
      given="$(stealth_targets_of_urls "$list")"
      [ -n "$given" ] || usage_die "stealth hosts rm requires at least one host"
      stealth_write_hosts "$name" "$(printf '%s\n' "$saved" | grep -vxF "$given" || true)"
      printf "Removed %s from profile '%s'.\n" "$(stealth_hosts_commas "$given")" "$name" ;;
  esac
}

# agman stealth enable|disable [<name> | --profile <name>]
stealth_cmd_toggle() {
  local action="$1" name="" arg f
  shift
  # `--profile <name>` is accepted too: every other stealth subcommand spells
  # it that way, and the no-profile error suggests it.
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --profile) [ $# -gt 0 ] && [ -n "$1" ] || usage_die "--profile requires a profile name"
                 arg="$1"; shift ;;
      -*) usage_die "unknown option '$arg' for stealth $action" ;;
    esac
    [ -z "$name" ] || usage_die "stealth $action takes at most one profile name"
    name="$arg"
  done
  name="$(stealth_target_profile "$name")"
  f="$(stealth_profile_file "$name" enabled)"
  if [ "$action" = "disable" ]; then
    rm -f "$f"
    printf "Stealth disabled for profile '%s'.\n" "$name"
    return 0
  fi
  mkdir -p "$STEALTH_PROFILES_DIR"
  : > "$f"
  printf "Stealth enabled for profile '%s': 'agman run %s' and, with shell integration, plain 'claude' now launch through the proxy.\n" "$name" "$name"
  if [ -z "$(stealth_saved_hosts "$name")" ] && \
     [ -z "$(stealth_detect "$(profile_claude_dir "$(profile_dir "$name")")")" ]; then
    warn "no hosts saved or detected for '$name'; launches will refuse to start until you add one: agman stealth hosts add <host> --profile $name"
  fi
}

# Exit status only: is stealth on for the profile a bare `claude` would use?
# Called by the shell integration before every claude launch, so it stays cheap.
stealth_cmd_enabled() {
  local name
  name="$(stealth_current_profile)" || return 1
  stealth_is_enabled "$name"
}

cmd_stealth() {
  local sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    claude)  stealth_claude ${1+"$@"} ;;
    stop)    stealth_stop_daemon ;;
    status)  stealth_status ;;
    detect)  stealth_cmd_detect ${1+"$@"} ;;
    hosts)   stealth_cmd_hosts ${1+"$@"} ;;
    enable|disable) stealth_cmd_toggle "$sub" ${1+"$@"} ;;
    enabled) stealth_cmd_enabled ;;
    ""|-h|--help) help_stealth ;;
    *) usage_die "unknown stealth subcommand '$sub' (claude|stop|status|detect|hosts|enable|disable)" ;;
  esac
}

help_summary() {
  cat <<EOF
agman $AGMAN_VERSION — switch config profiles for Claude Code, Codex CLI and Gemini CLI

Usage: agman <command> [args]
       agman <command> --help

Everyday:
  list, ls              Show your profiles (* = active)
  current               Show which profile is active
  use [name]            Switch every tool to a profile (no name: pick from a list)
  off                   Stop switching and restore your original configs
  create <name>         Make a new profile (--copy-current copies your setup)

Manage profiles:
  rename <old> <new>    Rename a profile
  remove, rm <name>     Delete a profile, not the active one (--yes: no prompt)
  login <name>          Give a profile its own Claude account
  logout <name>         Go back to the shared Claude login

One shell or one command only:
  run [name]            Start claude once with a profile
  exec <name> -- <cmd>  Run any command with a profile
  env <name>            Print exports: eval "\$(agman env work)"
  dir <name>            Print a profile's Claude config folder

Maintenance:
  doctor                Check your setup for problems
  update                Update agman
  migrate               Move old profiles to the current layout
  init [zsh|bash]       Print the optional shell integration
  version               Print the agman version

Advanced:
  cloud <command>       Sync profiles with an agman cloud server
  stealth <command>     Block company telemetry (OTEL) when claude runs

Examples:
  agman create work --copy-current
  agman use work
  agman current

More help:
  agman help <command>     Options for one command (e.g. agman help cloud)
  agman help projects      Pick a profile per repository with a .agman file
  agman help tools         Which tools agman manages
  agman help environment   Environment variables
  agman help all           Everything
EOF
}

help_create() {
  cat <<'EOF'
agman create <name> [options]

  Make a new profile. By default it is empty apart from a starter CLAUDE.md.

  --copy-current    Start from the configs you are using right now
  --from <name>     Copy another profile
  --link-plugins    Link plugins/ instead of copying it
EOF
}

help_use() {
  cat <<'EOF'
agman use [name]

  Switch every managed tool to a profile by pointing ~/.claude, ~/.claude.json,
  ~/.codex and ~/.gemini at it. Applies to every new session, IDEs included;
  sessions already running keep their old config.

  The first switch saves your original configs as the profile 'global'.
  'agman off' puts them back exactly as they were.

  With no name, the profile comes from the nearest .agman file
  (see 'agman help projects'). Without one, a terminal shows a menu:
  ↑/↓ or j/k to move, 1-9 to jump, Enter to switch, q or Esc to cancel.
EOF
}

help_run() {
  cat <<'EOF'
agman run [name] [-- claude args]
agman exec <name> -- <command>
agman env <name>

  Use a profile for one process or one shell without switching the machine.

  run    Start claude once with the profile. Arguments after -- go to claude.
         With no name, uses the nearest .agman file.
  exec   Run any command with the profile's environment variables set.
  env    Print export lines for this shell:  eval "$(agman env work)"

  A CLAUDE_CONFIG_DIR set in a shell always wins over 'agman use' there.
  Launched from the home directory, the machine-active profile's CLAUDE.md
  and rules are excluded from the child (claudeMdExcludes), so only the
  asked-for profile's memory loads — unless you pass --settings yourself.
EOF
}

help_dir() {
  cat <<'EOF'
agman dir <name> | --active | --for-cwd

  Print a profile's Claude config folder.

  --active    The active profile
  --for-cwd   The profile named by the nearest trusted .agman file
EOF
}

help_login() {
  cat <<'EOF'
agman login <name> [options]
agman logout <name>

  By default every profile shares your Claude login. 'login' gives one profile
  its own account (its own token); 'logout' drops it again.

  --token-stdin   Read the token from stdin
  --no-run        Don't run 'claude setup-token' first
EOF
}

help_cloud() {
  cat <<'EOF'
agman cloud <command> [options]

  Sync profiles with an agman cloud server (default https://agman.vercel.app).

Commands:
  login [--url <url>] [--key-stdin]          Connect to a server
  push [name] [--dry-run] [--force]          Upload a profile
  pull <name> [--as <local>] [--force]       Download a profile
  init <org-slug> [name]                     Start from an org's profile
  list | status | logout

Options:
  --dry-run          List what a push would upload, upload nothing
  --include-secrets  (push) Also upload logins and tokens
  --with-secrets     (pull, init) Also download logins and tokens
  --verbose          Log each request, its payload size and response code

What gets synced:
  A synced profile is a persona, not a login. Logins, tokens, codex/gemini auth,
  .env and session state stay on this machine unless you pass the secrets flags.
  A push is refused if a file looks like it holds a secret. Pushes are versioned
  on the server. Plugin caches are never synced; pull reinstalls plugins with
  the claude CLI.

Safety on pull:
  Hooks and apiKeyHelper are removed from a downloaded settings.json, an existing
  profile is backed up first, and the active profile is refused without --force.

Size:
  A push over the server's limit is refused before upload and names the largest
  files. Large archives upload through the server's blob flow automatically.

Environment:
  AGMAN_VERBOSE=1                 Same as --verbose
  AGMAN_CLOUD_MAX_PUSH_BYTES      Override the push size limit
  AGMAN_CLOUD_NO_INSTALL=1        Don't reinstall plugins after pull
  AGMAN_CLOUD_INSECURE=1          Allow http:// servers
  AGMAN_PROGRESS                  Upload progress: unset = auto, 1 = on, 0 = off
EOF
}

help_stealth() {
  cat <<'EOF'
agman stealth — stop Claude Code from sending telemetry (OTEL) to your company

Quick start:
  agman stealth detect            See which telemetry hosts were found
  agman stealth enable [name]     Always protect this profile (default: active one)
  agman stealth claude            Start claude with telemetry blocked

All commands:
  agman stealth claude [--otel <host>] [--save] [--profile <name>] [claude args]
  agman stealth hosts [list|add|rm] [<host>…] [--profile <name>]
  agman stealth enable [name]  /  agman stealth disable [name]
  agman stealth detect [--profile <name>]
  agman stealth status
  agman stealth stop

How it works:
  claude runs through a small local proxy. The exporter's own request paths
  (/v1/traces, /v1/metrics, /v1/logs) get a 403; everything else, including
  api.anthropic.com and any non-telemetry traffic to the blocked host itself,
  works normally. Needs mitmproxy, lsof and curl (macOS: brew install mitmproxy).

Which hosts are blocked:
  - hosts you pass with --otel (add --save to remember them); when the URL
    carries a path, only the exporter's paths under it are blocked
  - hosts saved with 'agman stealth hosts add'
  - hosts found automatically in your environment and in Claude's settings
    (profile, project, and company-managed). localhost is never blocked.
  If none are found, claude is not started.

When it applies:
  - 'agman stealth claude' always.
  - 'agman run <name>' when the profile is enabled.
  - plain 'claude' when the profile is enabled and 'agman init' is loaded
    in your shell. IDE extensions are not covered.
  The proxy keeps running, and keeps every host it has blocked, until
  'agman stealth stop'.

Hosts can be full URLs or bare names; list several with commas:
  agman stealth claude --otel https://a.example.com/v1/traces, b.example.com

Environment:
  AGMAN_STEALTH_PORT     Proxy port (default 8080)
  AGMAN_STEALTH_CA       mitmproxy CA (default ~/.mitmproxy/mitmproxy-ca-cert.pem)
  AGMAN_STEALTH_MANAGED  Managed-settings files to scan, separated by ':'
  State lives in ~/.agman/.stealth.
EOF
}

help_projects() {
  cat <<'EOF'
Per-project profiles

  Put a .agman file in a repository root naming the profile it wants:

      profile: acme-work

  'agman use' and 'agman run' with no name read it. Because the file arrives
  with a clone, agman asks once before trusting it.

  With the shell integration ('agman init'), each terminal switches profile as
  you change directory. IDE extensions don't see shell variables, so they
  follow 'agman use' instead.
EOF
}

help_tools() {
  cat <<'EOF'
Supported tools

  claude   Claude Code   ~/.claude + ~/.claude.json   (env: CLAUDE_CONFIG_DIR)
  codex    Codex CLI     ~/.codex                     (env: CODEX_HOME)
  gemini   Gemini CLI    ~/.gemini                    (no env override)

  agman only manages tools you have: a profile covers a tool when it holds
  config for it, the CLI is on PATH, or its config path exists.
EOF
}

help_environment() {
  cat <<'EOF'
Environment variables

  AGMAN_HOME          Where profiles are stored (default ~/.agman)
  AGMAN_TARGET_HOME   Where tool configs live (default $HOME)
  AGMAN_TOOLS         Only manage these tools, e.g. "claude codex"
  AGMAN_SHARE_STATE   1 (default): share session history across profiles so
                      'claude --resume' keeps working. 0: keep it per profile.
  AGMAN_RAW_URL       Where 'agman update' downloads from

  Cloud and stealth variables: see 'agman help cloud' and 'agman help stealth'.
EOF
}

cmd_help() {
  local topic="${1:-}" line
  case "$topic" in
    "") help_summary ;;
    all)
      help_summary
      for topic in create use run dir login cloud stealth projects tools environment; do
        printf '\n'; "help_$topic"
      done ;;
    create|use|dir|login|cloud|stealth|projects|tools|environment) "help_$topic" ;;
    run|exec|env) help_run ;;
    logout) help_login ;;
    *)
      [ "$topic" = "ls" ] && topic="list"
      [ "$topic" = "rm" ] && topic="remove"
      line="$(help_summary | grep -E "^  $topic(,| |\$)" || true)"
      [ -n "$line" ] || usage_die "no help for '$topic'"
      printf 'agman %s\n\n%s\n' "$topic" "$line" ;;
  esac
}

# ---------------------------------------------------------------------------
# dispatch

main() {
  local cmd="${1:-help}" arg
  [ $# -gt 0 ] && shift
  # --help must never run the command. run/exec/stealth forward everything
  # after their first argument, so only that first argument can ask for help.
  case "$cmd" in
    help|-h|--help) ;;
    run|exec|stealth)
      case "${1:-}" in -h|--help) cmd_help "$cmd"; return ;; esac ;;
    *)
      for arg in ${1+"$@"}; do
        [ "$arg" = "--" ] && break
        case "$arg" in -h|--help) cmd_help "$cmd"; return ;; esac
      done ;;
  esac
  case "$cmd" in
    create)  cmd_create ${1+"$@"} ;;
    list|ls|--list) cmd_list ;;
    use)     cmd_use ${1+"$@"} ;;
    off)     cmd_off ;;
    current) cmd_current ;;
    dir)     cmd_dir ${1+"$@"} ;;
    env)     cmd_env ${1+"$@"} ;;
    run)     cmd_run ${1+"$@"} ;;
    exec)    cmd_exec ${1+"$@"} ;;
    rename)  cmd_rename ${1+"$@"} ;;
    remove|rm) cmd_remove ${1+"$@"} ;;
    login)   cmd_login ${1+"$@"} ;;
    logout)  cmd_logout ${1+"$@"} ;;
    cloud)   cmd_cloud ${1+"$@"} ;;
    stealth) cmd_stealth ${1+"$@"} ;;
    migrate) cmd_migrate ;;
    update)  cmd_update ;;
    doctor)  cmd_doctor ;;
    init)    cmd_init ${1+"$@"} ;;
    help|-h|--help) cmd_help ${1+"$@"} ;;
    version|-v|--version) printf 'agman %s\n' "$AGMAN_VERSION" ;;
    *) usage_die "unknown command '$cmd'" ;;
  esac
}

main ${1+"$@"}
