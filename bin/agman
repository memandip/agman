#!/usr/bin/env bash
#
# agman — agent manager: switchable config profiles for AI coding agents,
# in the spirit of AWS_PROFILE. Claude Code adapter today; Codex (CODEX_HOME)
# and Gemini CLI are on the roadmap.
#
# Each profile is a self-contained Claude Code config directory under
# $AGMAN_HOME (default: ~/.agman/<name>). `agman use` activates a profile by
# symlinking ~/.claude at it; your original ~/.claude is preserved as the
# 'global' profile the first time you switch, and `agman off` restores it.
# The symlink itself is the marker: a real ~/.claude directory is unmanaged,
# a symlink into $AGMAN_HOME is an agman profile.
#
# Requires bash >= 3.2 (stock macOS bash works). No other dependencies.

set -euo pipefail

AGMAN_VERSION="0.3.0"

AGMAN_HOME="${AGMAN_HOME:-$HOME/.agman}"
# The config dir Claude Code reads. Only ever moved/symlinked, never edited.
CLAUDE_HOME="${AGMAN_CLAUDE_HOME:-$HOME/.claude}"
# User-scope MCP servers and global state live next to the config dir.
CLAUDE_JSON="$(dirname "$CLAUDE_HOME")/.claude.json"
DEFAULT_FILE="$AGMAN_HOME/.default"
GLOBAL_BACKUP="$AGMAN_HOME/global"
# Canonical shared credential file. On Linux/Windows Claude Code keeps
# .credentials.json inside the config dir, so profiles that share an account
# symlink to this one file and token refreshes stay visible to all of them.
# On macOS credentials live in the Keychain and this stays absent.
SHARED_CREDS="$AGMAN_HOME/.credentials.json"
CREDS_BASENAME=".credentials.json"
AGMAN_RAW_URL="${AGMAN_RAW_URL:-https://raw.githubusercontent.com/memandip/agman/main}"

# Ephemeral or machine-local state that should not be cloned into a profile.
SEED_EXCLUDES=(backups cache downloads file-history ide locks logs paste-cache
  projects session-env sessions shell-snapshots statsig tasks telemetry todos
  history.jsonl mcp-needs-auth-cache.json .last-cleanup .DS_Store
  .credentials.json)

# ---------------------------------------------------------------------------
# helpers

die() { printf 'agman: %s\n' "$*" >&2; exit 1; }
warn() { printf 'agman: warning: %s\n' "$*" >&2; }

usage_die() { printf 'agman: %s\n' "$*" >&2; printf "Run 'agman help' for usage.\n" >&2; exit 2; }

profile_dir() { printf '%s/%s' "$AGMAN_HOME" "$1"; }

readlink_once() { readlink "$1" 2>/dev/null || true; }

validate_name() {
  local name="${1:-}"
  [ -n "$name" ] || usage_die "profile name required"
  [ "${#name}" -le 64 ] || die "profile name too long (max 64 chars)"
  case "$name" in
    .*|-*) die "invalid profile name '$name' (must not start with '.' or '-')" ;;
    *[!A-Za-z0-9._-]*) die "invalid profile name '$name' (allowed: letters, digits, '.', '_', '-')" ;;
  esac
}

# Names users may create. 'global' is reserved for the automatic backup of the
# original ~/.claude, so it can exist and be switched to, but not created.
require_creatable_name() {
  validate_name "$1"
  case "$1" in
    default|off|none|current|help|global)
      die "'$1' is a reserved word and cannot be used as a profile name" ;;
  esac
}

require_profile() {
  validate_name "$1"
  [ -d "$(profile_dir "$1")" ] || die "profile '$1' not found (run 'agman list')"
}

default_profile() {
  [ -f "$DEFAULT_FILE" ] || return 1
  local name
  IFS= read -r name < "$DEFAULT_FILE" || true
  [ -n "$name" ] || return 1
  printf '%s' "$name"
}

# State of ~/.claude: real | agman | foreign | absent
claude_home_kind() {
  if [ -L "$CLAUDE_HOME" ]; then
    case "$(readlink_once "$CLAUDE_HOME")" in
      "$AGMAN_HOME"/*) printf 'agman' ;;
      *) printf 'foreign' ;;
    esac
  elif [ -d "$CLAUDE_HOME" ]; then
    printf 'real'
  elif [ -e "$CLAUDE_HOME" ]; then
    printf 'foreign'
  else
    printf 'absent'
  fi
}

# Name of the profile ~/.claude currently points at; rc 1 if not agman-managed.
active_profile() {
  [ -L "$CLAUDE_HOME" ] || return 1
  local target
  target="$(readlink_once "$CLAUDE_HOME")"
  case "$target" in
    "$AGMAN_HOME"/*) printf '%s' "${target##*/}"; return 0 ;;
  esac
  return 1
}

is_seed_excluded() {
  local base="$1" x
  for x in "${SEED_EXCLUDES[@]}"; do
    if [ "$base" = "$x" ]; then return 0; fi
  done
  return 1
}

# Copy the contents of a config dir into a new profile dir, skipping
# ephemeral state. Optionally symlink the plugins dir instead of copying it.
seed_from_dir() {
  local src="$1" dst="$2" link_plugins="$3" entry base
  [ -d "$src" ] || { warn "seed source $src not found; profile starts empty"; return 0; }
  while IFS= read -r -d '' entry; do
    base="${entry##*/}"
    if is_seed_excluded "$base"; then continue; fi
    if [ "$base" = "plugins" ] && [ "$link_plugins" = "1" ]; then
      if ! ln -s "$entry" "$dst/plugins" 2>/dev/null; then
        warn "symlinks unavailable on this filesystem; copying plugins instead"
        cp -R "$entry" "$dst/plugins"
      fi
      continue
    fi
    cp -R "$entry" "$dst/$base"
  done < <(find "$src" -mindepth 1 -maxdepth 1 -print0)
}

# --- identity / auth inheritance ------------------------------------------
#
# Claude Code decides whether to run first-launch onboarding from
# ~/.claude.json, not from the credential store: its own code gates on
# `if (!config.hasCompletedOnboarding)`, and it treats auth as cached when
# `oauthAccount !== undefined || hasCompletedOnboarding === true`. A profile
# with an empty {} therefore triggers login even when a valid token exists.
# Seeding these keys is what makes a new profile inherit the current account.
IDENTITY_KEYS="oauthAccount hasCompletedOnboarding userID machineID lastOnboardingVersion"

# Which helper is available for a structured JSON merge.
json_tool() {
  if command -v jq >/dev/null 2>&1; then printf 'jq'
  elif command -v python3 >/dev/null 2>&1; then printf 'python3'
  else printf 'none'; fi
}

# Copy identity keys from a source .claude.json into a profile's own copy,
# preserving anything already there. Falls back to a whole-file copy when no
# JSON tool exists, which keeps auth working at the cost of extra state.
seed_identity() {
  local src="$1" dst="$2" tmp
  [ -f "$src" ] || return 1
  tmp="$dst.agman-tmp.$$"
  case "$(json_tool)" in
    jq)
      if ! jq -n --arg keys "$IDENTITY_KEYS" \
            --slurpfile s "$src" \
            '($keys | split(" ")) as $k
             | ($s[0] // {}) as $src
             | reduce $k[] as $key ({}; if ($src | has($key)) then .[$key] = $src[$key] else . end)' \
            > "$tmp" 2>/dev/null; then
        rm -f "$tmp"; return 1
      fi
      # Merge onto any existing profile state (profile keys win only if newer
      # writes happen later; identity is authoritative here).
      if [ -s "$dst" ] && jq -e . "$dst" >/dev/null 2>&1; then
        if jq -s '.[0] * .[1]' "$dst" "$tmp" > "$tmp.2" 2>/dev/null; then
          mv "$tmp.2" "$tmp"
        else
          rm -f "$tmp.2"
        fi
      fi
      ;;
    python3)
      if ! SRC="$src" DST="$dst" KEYS="$IDENTITY_KEYS" python3 -c '
import json, os, sys
src, dst, keys = os.environ["SRC"], os.environ["DST"], os.environ["KEYS"].split()
try:
    s = json.load(open(src))
except Exception:
    sys.exit(1)
if not isinstance(s, dict):
    sys.exit(1)
try:
    d = json.load(open(dst))
    if not isinstance(d, dict):
        d = {}
except Exception:
    d = {}
for k in keys:
    if k in s:
        d[k] = s[k]
sys.stdout.write(json.dumps(d, indent=2) + "\n")
' > "$tmp" 2>/dev/null; then
        rm -f "$tmp"; return 1
      fi
      ;;
    none)
      warn "neither jq nor python3 found; copying the whole config state to preserve login"
      cp "$src" "$tmp" || { rm -f "$tmp"; return 1; }
      ;;
  esac
  mv "$tmp" "$dst" || { rm -f "$tmp"; return 1; }
  chmod 600 "$dst" 2>/dev/null || true
  return 0
}

# Best source of identity state: the live file while it is still a real file,
# otherwise the backup of the original config.
identity_source() {
  if [ -f "$CLAUDE_JSON" ] && [ ! -L "$CLAUDE_JSON" ]; then
    printf '%s' "$CLAUDE_JSON"; return 0
  fi
  if [ -f "$GLOBAL_BACKUP/.claude.json" ]; then
    printf '%s' "$GLOBAL_BACKUP/.claude.json"; return 0
  fi
  if [ -L "$CLAUDE_JSON" ]; then
    local t; t="$(readlink_once "$CLAUDE_JSON")"
    [ -f "$t" ] && { printf '%s' "$t"; return 0; }
  fi
  return 1
}

# True when a profile's .claude.json carries usable account identity.
has_identity() {
  local f="$1/.claude.json"
  [ -f "$f" ] || return 1
  grep -q '"hasCompletedOnboarding"[[:space:]]*:[[:space:]]*true' "$f" 2>/dev/null && return 0
  grep -q '"oauthAccount"[[:space:]]*:[[:space:]]*{' "$f" 2>/dev/null && return 0
  return 1
}

# Move the original credential file to the shared location once, so every
# profile that shares the account sees the same refreshed tokens.
adopt_shared_credentials() {
  local src="$1/$CREDS_BASENAME"
  [ -f "$src" ] || return 0
  [ -L "$src" ] && return 0
  if [ ! -e "$SHARED_CREDS" ]; then
    mv "$src" "$SHARED_CREDS" || return 1
    chmod 600 "$SHARED_CREDS" 2>/dev/null || true
    ln -s "$SHARED_CREDS" "$src" 2>/dev/null || cp "$SHARED_CREDS" "$src"
  fi
  return 0
}

# Point a profile at the shared credential file unless it deliberately holds
# its own (a real file placed there by the user or a future per-account login).
link_shared_credentials() {
  local dir="$1" target
  target="$dir/$CREDS_BASENAME"
  # Drop a link left dangling by a previous 'off', which would otherwise look
  # like a credential file to Claude Code.
  if [ -L "$target" ] && [ ! -e "$target" ]; then rm -f "$target"; fi
  [ -f "$SHARED_CREDS" ] || return 0
  [ -L "$target" ] && return 0
  [ -e "$target" ] && return 0
  ln -s "$SHARED_CREDS" "$target" 2>/dev/null || cp "$SHARED_CREDS" "$target"
  return 0
}

# Describe a profile's credential situation for doctor/current. Never prints
# token material.
profile_auth_state() {
  local dir="$1" f
  f="$dir/$CREDS_BASENAME"
  local ident="no-identity" creds="keychain-or-none"
  has_identity "$dir" && ident="identity-seeded"
  if [ -L "$f" ]; then
    creds="shared-credentials"
  elif [ -f "$f" ]; then
    creds="own-credentials"
  fi
  printf '%s, %s' "$ident" "$creds"
}

write_starter_claude_md() {
  local dir="$1" name="$2"
  cat > "$dir/CLAUDE.md" <<EOF
# CLAUDE.md — $name profile (managed by agman)

Instructions here apply to every Claude Code session while this profile
is active. Replace this starter content with your own rules, for example:

- Coding style preferences
- Workflow rules ("always run tests before committing")
- Project or client context specific to this profile
EOF
}

# ---------------------------------------------------------------------------
# commands

cmd_create() {
  local name="" mode="empty" from="" link_plugins=0 arg src_json=""
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --empty) mode="empty" ;;
      --copy-current|--from-current) mode="current" ;;
      --from) [ $# -gt 0 ] || usage_die "--from requires a profile name"; from="$1"; shift; mode="clone" ;;
      --link-plugins) link_plugins=1 ;;
      -*) usage_die "unknown option '$arg' for create" ;;
      *) [ -z "$name" ] && name="$arg" || usage_die "unexpected argument '$arg'" ;;
    esac
  done
  require_creatable_name "$name"

  mkdir -p "$AGMAN_HOME"
  local dir; dir="$(profile_dir "$name")"
  [ ! -e "$dir" ] || die "profile '$name' already exists at $dir"
  mkdir "$dir"

  case "$mode" in
    empty)
      write_starter_claude_md "$dir" "$name"
      if src_json="$(identity_source)" && seed_identity "$src_json" "$dir/.claude.json"; then
        printf "Created profile '%s' at %s (empty, with a starter CLAUDE.md).\n" "$name" "$dir"
        printf "It inherits your current Claude account, so no re-login is needed.\n"
      else
        printf "Created profile '%s' at %s (empty, with a starter CLAUDE.md).\n" "$name" "$dir"
        warn "could not read current account state; this profile may prompt for login"
      fi
      printf "Tip: use --copy-current to seed a profile from your current Claude config.\n"
      ;;
    current)
      local src="$CLAUDE_HOME"
      if [ -L "$CLAUDE_HOME" ]; then
        src="$(readlink_once "$CLAUDE_HOME")"
        [ -n "$src" ] || die "cannot resolve ~/.claude symlink"
      fi
      seed_from_dir "$src" "$dir" "$link_plugins"
      if [ -f "$CLAUDE_JSON" ] && [ ! -e "$dir/.claude.json" ]; then
        cp "$CLAUDE_JSON" "$dir/.claude.json"
        chmod 600 "$dir/.claude.json" 2>/dev/null || true
      fi
      if ! has_identity "$dir" && src_json="$(identity_source)"; then
        seed_identity "$src_json" "$dir/.claude.json" || true
      fi
      [ -f "$dir/CLAUDE.md" ] || write_starter_claude_md "$dir" "$name"
      printf "Created profile '%s' at %s (copied from current Claude config).\n" "$name" "$dir"
      ;;
    clone)
      require_profile "$from"
      seed_from_dir "$(profile_dir "$from")" "$dir" "$link_plugins"
      printf "Created profile '%s' at %s (cloned from '%s').\n" "$name" "$dir" "$from"
      ;;
  esac
  printf "Switch to it with: agman use %s\n" "$name"
}

cmd_list() {
  [ -d "$AGMAN_HOME" ] || { printf "No profiles yet. Create one with: agman create <name>\n"; return 0; }
  local default_name="" active_name="" entry name marker suffix found=0
  default_name="$(default_profile 2>/dev/null || true)"
  active_name="$(active_profile 2>/dev/null || true)"
  for entry in "$AGMAN_HOME"/*/; do
    [ -d "$entry" ] || continue
    found=1
    entry="${entry%/}"
    name="${entry##*/}"
    marker="  "
    [ "$name" = "$default_name" ] && marker="* "
    suffix=""
    [ "$name" = "$active_name" ] && suffix="  (active)"
    [ "${CLAUDE_CONFIG_DIR:-}" = "$entry" ] && suffix="$suffix  (active in this shell)"
    printf '%s%s%s\n' "$marker" "$name" "$suffix"
  done
  [ "$found" = "1" ] || printf "No profiles yet. Create one with: agman create <name>\n"
}

cmd_use() {
  local name="${1:-}"
  require_profile "$name"
  local dir; dir="$(profile_dir "$name")"
  local kind; kind="$(claude_home_kind)"
  local migrated=0

  case "$kind" in
    foreign)
      die "~/.claude exists but is not managed by agman ($(readlink_once "$CLAUDE_HOME" || printf 'not a directory')). Refusing to touch it."
      ;;
    real)
      [ ! -e "$GLOBAL_BACKUP" ] || die "cannot back up ~/.claude: a 'global' profile already exists at $GLOBAL_BACKUP. Remove or rename it first."
      mkdir -p "$AGMAN_HOME"
      mv "$CLAUDE_HOME" "$GLOBAL_BACKUP"
      if [ -f "$CLAUDE_JSON" ] && [ ! -L "$CLAUDE_JSON" ] && [ ! -e "$GLOBAL_BACKUP/.claude.json" ]; then
        mv "$CLAUDE_JSON" "$GLOBAL_BACKUP/.claude.json"
      fi
      migrated=1
      ;;
  esac

  # Once the original config is backed up, promote its credential file (present
  # on Linux/Windows only) to the shared location so refreshed tokens stay
  # visible to every profile that shares the account.
  [ -d "$GLOBAL_BACKUP" ] && adopt_shared_credentials "$GLOBAL_BACKUP"

  # Profiles carry their own user-scope state file so MCP servers follow the
  # profile; make sure the symlink target exists before linking.
  [ -f "$dir/.claude.json" ] || printf '{}\n' > "$dir/.claude.json"

  # Repair profiles created before identity seeding existed, so switching never
  # drops the account and forces a re-login.
  local seeded=0 src_json=""
  if ! has_identity "$dir" && src_json="$(identity_source)"; then
    seed_identity "$src_json" "$dir/.claude.json" && seeded=1
  fi
  link_shared_credentials "$dir"

  [ -L "$CLAUDE_HOME" ] && rm -f "$CLAUDE_HOME"
  ln -s "$dir" "$CLAUDE_HOME"

  if [ -L "$CLAUDE_JSON" ]; then
    case "$(readlink_once "$CLAUDE_JSON")" in
      "$AGMAN_HOME"/*) rm -f "$CLAUDE_JSON"; ln -s "$dir/.claude.json" "$CLAUDE_JSON" ;;
      *) warn "~/.claude.json is a symlink not managed by agman; leaving it (user-scope MCP stays shared)" ;;
    esac
  elif [ ! -e "$CLAUDE_JSON" ]; then
    ln -s "$dir/.claude.json" "$CLAUDE_JSON"
  else
    warn "~/.claude.json is a regular file; leaving it in place (user-scope MCP stays shared across profiles)"
  fi

  mkdir -p "$AGMAN_HOME"
  printf '%s\n' "$name" > "$DEFAULT_FILE"

  printf "Switched to profile '%s' (~/.claude -> %s).\n" "$name" "$dir"
  if [ "$seeded" = "1" ]; then
    printf "Seeded this profile with your current Claude account (no re-login needed).\n"
  elif ! has_identity "$dir"; then
    warn "this profile has no saved account identity; Claude Code may prompt for login"
  fi
  if [ "$migrated" = "1" ]; then
    printf "Your original Claude config was backed up as the 'global' profile.\n"
    printf "Switch back with 'agman use global', or fully restore with 'agman off'.\n"
  fi
  printf "New Claude Code sessions everywhere (including IDEs) now use this profile.\n"
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    warn "CLAUDE_CONFIG_DIR is set in this shell and overrides the switch here"
  fi
}

cmd_off() {
  local kind; kind="$(claude_home_kind)"
  case "$kind" in
    agman)
      rm -f "$CLAUDE_HOME"
      if [ -L "$CLAUDE_JSON" ]; then
        case "$(readlink_once "$CLAUDE_JSON")" in
          "$AGMAN_HOME"/*) rm -f "$CLAUDE_JSON" ;;
        esac
      fi
      if [ -d "$GLOBAL_BACKUP" ]; then
        mv "$GLOBAL_BACKUP" "$CLAUDE_HOME"
        if [ -f "$CLAUDE_HOME/.claude.json" ] && [ ! -e "$CLAUDE_JSON" ]; then
          mv "$CLAUDE_HOME/.claude.json" "$CLAUDE_JSON"
        fi
        # Leave the restored config self-contained: replace the shared
        # credential link with the real file so it works without agman.
        if [ -L "$CLAUDE_HOME/$CREDS_BASENAME" ]; then
          rm -f "$CLAUDE_HOME/$CREDS_BASENAME"
          if [ -f "$SHARED_CREDS" ]; then
            cp "$SHARED_CREDS" "$CLAUDE_HOME/$CREDS_BASENAME"
            chmod 600 "$CLAUDE_HOME/$CREDS_BASENAME" 2>/dev/null || true
            rm -f "$SHARED_CREDS"
          fi
        fi
        printf "Restored your original Claude config to ~/.claude (the 'global' profile was moved back).\n"
      else
        printf "Profile deactivated. No 'global' backup existed; Claude Code will start fresh at ~/.claude.\n"
      fi
      ;;
    real)
      printf "Nothing to do: ~/.claude is already your own directory (not managed by agman).\n"
      ;;
    foreign)
      warn "~/.claude is a symlink not managed by agman; leaving it untouched"
      ;;
    absent)
      printf "Nothing to do: ~/.claude does not exist.\n"
      ;;
  esac
  rm -f "$DEFAULT_FILE"
}

cmd_current() {
  local name
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    name="${CLAUDE_CONFIG_DIR##*/}"
    if [ "$(profile_dir "$name")" = "$CLAUDE_CONFIG_DIR" ] && [ -d "$CLAUDE_CONFIG_DIR" ]; then
      printf '%s  (via CLAUDE_CONFIG_DIR in this shell)\n' "$name"
    else
      printf '(external dir via CLAUDE_CONFIG_DIR: %s)\n' "$CLAUDE_CONFIG_DIR"
    fi
    return 0
  fi
  if name="$(active_profile)"; then
    printf '%s  (active — ~/.claude is symlinked to this profile)\n' "$name"
    return 0
  fi
  case "$(claude_home_kind)" in
    real)    printf 'none  (stock ~/.claude, not managed by agman)\n' ;;
    foreign) printf 'none  (~/.claude is a symlink not managed by agman)\n' ;;
    *)       printf 'none  (no ~/.claude yet)\n' ;;
  esac
}

# Machine-readable resolver used by the optional shell integration's claude()
# wrapper. Resolves the persistent default only; an explicit CLAUDE_CONFIG_DIR
# always wins and is handled by the wrapper itself.
cmd_dir() {
  local arg="${1:-}"
  if [ "$arg" = "--active" ]; then
    local name
    name="$(default_profile)" || exit 1
    local dir; dir="$(profile_dir "$name")"
    [ -d "$dir" ] || exit 1
    printf '%s\n' "$dir"
    return 0
  fi
  require_profile "$arg"
  printf '%s\n' "$(profile_dir "$arg")"
}

cmd_env() {
  local name="${1:-}"
  require_profile "$name"
  printf 'export CLAUDE_CONFIG_DIR=%q\n' "$(profile_dir "$name")"
}

cmd_run() {
  local name="${1:-}"
  require_profile "$name"
  shift
  [ "${1:-}" = "--" ] && shift
  command -v claude >/dev/null 2>&1 || die "claude CLI not found on PATH"
  exec env CLAUDE_CONFIG_DIR="$(profile_dir "$name")" claude ${1+"$@"}
}

cmd_exec() {
  local name="${1:-}"
  require_profile "$name"
  shift
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || usage_die "exec requires a command: agman exec <name> -- <command...>"
  exec env CLAUDE_CONFIG_DIR="$(profile_dir "$name")" "$@"
}

cmd_rename() {
  local old="${1:-}" new="${2:-}"
  require_profile "$old"
  require_creatable_name "$new"
  [ ! -e "$(profile_dir "$new")" ] || die "profile '$new' already exists"
  local was_active=0
  [ "$(active_profile 2>/dev/null || true)" = "$old" ] && was_active=1
  mv "$(profile_dir "$old")" "$(profile_dir "$new")"
  if [ "$(default_profile 2>/dev/null || true)" = "$old" ]; then
    printf '%s\n' "$new" > "$DEFAULT_FILE"
  fi
  if [ "$was_active" = "1" ]; then
    rm -f "$CLAUDE_HOME"
    ln -s "$(profile_dir "$new")" "$CLAUDE_HOME"
    if [ -L "$CLAUDE_JSON" ]; then
      case "$(readlink_once "$CLAUDE_JSON")" in
        "$AGMAN_HOME"/*) rm -f "$CLAUDE_JSON"; ln -s "$(profile_dir "$new")/.claude.json" "$CLAUDE_JSON" ;;
      esac
    fi
  fi
  printf "Renamed profile '%s' to '%s'.\n" "$old" "$new"
}

cmd_remove() {
  local name="" yes=0 arg
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      -y|--yes) yes=1 ;;
      -*) usage_die "unknown option '$arg' for remove" ;;
      *) [ -z "$name" ] && name="$arg" || usage_die "unexpected argument '$arg'" ;;
    esac
  done
  require_profile "$name"
  if [ "$(active_profile 2>/dev/null || true)" = "$name" ]; then
    die "profile '$name' is active (~/.claude points at it). Switch away first: agman use <other> or agman off"
  fi
  local dir; dir="$(profile_dir "$name")"
  if [ "$yes" != "1" ]; then
    printf "Delete profile '%s' and everything in %s? [y/N] " "$name" "$dir"
    local reply=""
    IFS= read -r reply || true
    case "$reply" in y|Y|yes|YES) ;; *) printf 'Aborted.\n'; return 1 ;; esac
  fi
  rm -rf "$dir"
  if [ "$(default_profile 2>/dev/null || true)" = "$name" ]; then
    rm -f "$DEFAULT_FILE"
  fi
  printf "Removed profile '%s'.\n" "$name"
  if [ "$name" = "global" ]; then
    warn "'global' held the backup of your original ~/.claude; 'agman off' can no longer restore it"
  fi
}

cmd_doctor() {
  printf 'agman %s\n' "$AGMAN_VERSION"
  printf 'profiles home: %s\n' "$AGMAN_HOME"

  if command -v claude >/dev/null 2>&1; then
    local ver=""
    ver="$(claude --version 2>/dev/null | head -1 || true)"
    printf 'claude CLI:    %s (%s)\n' "$(command -v claude)" "${ver:-version unknown}"
  else
    printf 'claude CLI:    NOT FOUND on PATH\n'
  fi

  local count=0 entry
  if [ -d "$AGMAN_HOME" ]; then
    for entry in "$AGMAN_HOME"/*/; do
      [ -d "$entry" ] && count=$((count + 1))
    done
  fi
  printf 'profiles:      %s\n' "$count"

  local name
  case "$(claude_home_kind)" in
    agman)   printf '~/.claude:     -> profile %s (managed by agman)\n' "$(active_profile 2>/dev/null || printf '?')" ;;
    real)    printf '~/.claude:     regular directory (not managed; agman use <name> to switch)\n' ;;
    foreign) printf '~/.claude:     symlink NOT managed by agman (-> %s)\n' "$(readlink_once "$CLAUDE_HOME")" ;;
    absent)  printf '~/.claude:     missing\n' ;;
  esac

  if [ -d "$GLOBAL_BACKUP" ]; then
    printf "backup:        original config preserved as profile 'global'\n"
  else
    printf 'backup:        none (original config is in place or was never migrated)\n'
  fi

  if [ -f "$SHARED_CREDS" ]; then
    printf 'credentials:   shared file at %s (profiles symlink to it)\n' "$SHARED_CREDS"
  else
    printf 'credentials:   no shared file (normal on macOS, where Claude Code uses the Keychain)\n'
  fi
  printf 'json merge:    %s\n' "$(json_tool)"

  if [ -d "$AGMAN_HOME" ]; then
    local any=0
    for entry in "$AGMAN_HOME"/*/; do
      [ -d "$entry" ] || continue
      [ "$any" = "0" ] && printf '\nper-profile auth:\n' && any=1
      entry="${entry%/}"
      printf '  %-20s %s\n' "${entry##*/}" "$(profile_auth_state "$entry")"
    done
  fi

  if name="$(default_profile 2>/dev/null)"; then
    if [ -d "$(profile_dir "$name")" ]; then
      printf 'default:       %s\n' "$name"
    else
      printf 'default:       %s (STALE — directory missing; run: agman off)\n' "$name"
    fi
  else
    printf 'default:       none\n'
  fi

  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    printf 'env override:  CLAUDE_CONFIG_DIR=%s (wins over the symlink in this shell)\n' "$CLAUDE_CONFIG_DIR"
  else
    printf 'env override:  not set in this shell\n'
  fi

  local tmp
  tmp="$(mktemp -d)"
  if ln -s "$tmp" "$tmp/link-test" 2>/dev/null; then
    printf 'symlinks:      supported\n'
  else
    printf 'symlinks:      NOT supported (agman use cannot work on this filesystem)\n'
  fi
  rm -rf "$tmp"

  printf '\nnotes:\n'
  printf '  - Switching is symlink-based, so it applies to every new Claude Code\n'
  printf '    session on this machine, including IDE extensions.\n'
  printf '  - For a per-shell override without switching globally, use:\n'
  printf '    agman run/exec/env (they set CLAUDE_CONFIG_DIR for one process/shell).\n'
}

cmd_update() {
  local self target dir tmp new_ver
  self="${BASH_SOURCE[0]:-$0}"
  if [ -L "$self" ]; then
    target="$(readlink_once "$self")"
    case "$target" in
      /*) self="$target" ;;
      *)  self="$(dirname "$self")/$target" ;;
    esac
  fi
  dir="$(cd "$(dirname "$self")" && pwd -P)"
  self="$dir/$(basename "$self")"

  if [ -d "$dir/../.git" ] && command -v git >/dev/null 2>&1; then
    printf 'Updating from git checkout: %s\n' "$(cd "$dir/.." && pwd -P)"
    git -C "$dir/.." pull --ff-only || die "git pull failed; resolve manually"
    new_ver="$(grep -m1 '^AGMAN_VERSION=' "$self" | cut -d'"' -f2 || true)"
    printf 'agman updated: %s -> %s\n' "$AGMAN_VERSION" "${new_ver:-unknown}"
    return 0
  fi

  command -v curl >/dev/null 2>&1 || die "curl is required for self-update"
  tmp="$(mktemp "$dir/.agman-update.XXXXXX")" || die "cannot write to $dir (try with appropriate permissions)"
  if ! curl -fsSL "$AGMAN_RAW_URL/bin/agman" -o "$tmp"; then
    rm -f "$tmp"
    die "download failed from $AGMAN_RAW_URL"
  fi
  if ! bash -n "$tmp" 2>/dev/null; then
    rm -f "$tmp"
    die "downloaded file failed validation; keeping current version"
  fi
  new_ver="$(grep -m1 '^AGMAN_VERSION=' "$tmp" | cut -d'"' -f2 || true)"
  chmod +x "$tmp"
  mv "$tmp" "$self" || { rm -f "$tmp"; die "cannot replace $self (permissions?)"; }
  printf 'agman updated: %s -> %s (%s)\n' "$AGMAN_VERSION" "${new_ver:-unknown}" "$self"
}

cmd_init() {
  local shell="${1:-auto}"
  if [ "$shell" = "auto" ]; then
    shell="${SHELL:-bash}"
    shell="${shell##*/}"
  fi
  case "$shell" in
    zsh|bash) ;;
    *) die "unsupported shell '$shell' (zsh and bash are supported; fish is on the roadmap)" ;;
  esac
  cat <<'AGMAN_SNIPPET'
# >>> agman shell integration (optional) >>>
# Switching profiles works without this — `agman use` swaps ~/.claude via
# symlink. This hook adds per-shell behavior on top: `use`/`off` also
# export/unset CLAUDE_CONFIG_DIR so the current shell can diverge from the
# machine-wide profile.
export AGMAN_SHELL_INTEGRATION=1

agman() {
  case "${1:-}" in
    use)
      command agman "$@" || return $?
      local _agman_dir
      if _agman_dir="$(command agman dir "${2:-}" 2>/dev/null)" && [ -n "$_agman_dir" ]; then
        export CLAUDE_CONFIG_DIR="$_agman_dir"
      fi
      ;;
    off)
      command agman "$@" || return $?
      unset CLAUDE_CONFIG_DIR
      ;;
    *)
      command agman "$@"
      ;;
  esac
}

claude() {
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    command claude "$@"
    return $?
  fi
  local _agman_dir
  if _agman_dir="$(command agman dir --active 2>/dev/null)" && [ -n "$_agman_dir" ]; then
    CLAUDE_CONFIG_DIR="$_agman_dir" command claude "$@"
  else
    command claude "$@"
  fi
}
# <<< agman shell integration <<<
AGMAN_SNIPPET
}

cmd_help() {
  cat <<EOF
agman $AGMAN_VERSION — agent manager: config profiles for AI coding agents

Usage: agman <command> [args]

Commands:
  create <name> [opts]   Create a profile (empty, with a starter CLAUDE.md).
                           --copy-current   seed from your current Claude config
                           --from <name>    clone another profile
                           --link-plugins   symlink plugins/ instead of copying
  list                   List profiles (* = default, (active) = ~/.claude target)
  use <name>             Activate a profile: symlinks ~/.claude -> profile.
                         First use backs up your original config as 'global'.
  off                    Deactivate and restore your original ~/.claude
  current                Show the active profile and how it was selected
  dir <name>|--active    Print a profile's directory
  env <name>             Print an export line: eval "\$(agman env work)"
  run <name> [-- args]   Launch claude once under a profile (per-process)
  exec <name> -- <cmd>   Run any command with CLAUDE_CONFIG_DIR set
  rename <old> <new>     Rename a profile (repoints ~/.claude if active)
  remove <name> [--yes]  Delete a profile (refuses if active)
  update                 Self-update: git pull in a checkout, else download latest
  doctor                 Diagnose setup
  init [zsh|bash]        Print optional per-shell integration snippet
  help, version

How switching works:
  'agman use <name>' symlinks ~/.claude (and ~/.claude.json) at the profile, so
  every new Claude Code session on this machine picks it up — no shell setup,
  IDE extensions included. Your original config is preserved as the 'global'
  profile on first switch; 'agman use global' returns to it, 'agman off'
  restores it fully. A CLAUDE_CONFIG_DIR env var set in a shell overrides the
  symlink for that shell only (see: env, run, exec).

Environment:
  AGMAN_HOME             Profile storage root (default: ~/.agman)
  AGMAN_CLAUDE_HOME      Managed config path (default: ~/.claude)
  AGMAN_RAW_URL          Update source (default: GitHub main branch)
EOF
}

# ---------------------------------------------------------------------------
# dispatch

main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    create)  cmd_create ${1+"$@"} ;;
    list|ls) cmd_list ;;
    use)     cmd_use ${1+"$@"} ;;
    off)     cmd_off ;;
    current) cmd_current ;;
    dir)     cmd_dir ${1+"$@"} ;;
    env)     cmd_env ${1+"$@"} ;;
    run)     cmd_run ${1+"$@"} ;;
    exec)    cmd_exec ${1+"$@"} ;;
    rename)  cmd_rename ${1+"$@"} ;;
    remove|rm) cmd_remove ${1+"$@"} ;;
    update)  cmd_update ;;
    doctor)  cmd_doctor ;;
    init)    cmd_init ${1+"$@"} ;;
    help|-h|--help) cmd_help ;;
    version|-v|--version) printf 'agman %s\n' "$AGMAN_VERSION" ;;
    *) usage_die "unknown command '$cmd'" ;;
  esac
}

main ${1+"$@"}
